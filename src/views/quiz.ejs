<!-- Create Room Section -->
<div class="container mx-auto px-4 mb-12 mt-6">
  <div class="bg-gradient-to-br bg-white via-blue-100 rounded-3xl p-10 text-white relative overflow-hidden shadow-2xl">
    <!-- Floating shapes -->
    <div class="pointer-events-none select-none">
      <span class="absolute text-2xl top-2 left-1/2">🌱</span>
      <span class="absolute text-2xl top-1/3 left-1/5">🍀</span>
      <span class="absolute text-2xl top-2/3 left-2/3">🥑</span>
      <span class="absolute text-2xl top-3/6 left-4/5">🍉</span>
      <span class="absolute top-4 right-4 text-6xl opacity-20 select-none pointer-events-none">➕</span>
    </div>
    <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex flex-col gap-4">
        <h2 class="text-black text-3xl md:text-4xl font-extrabold mb-2 text-shadow">เลือกห้องสำหรับเล่นเกมตอบคำถาม</h2>
        <p class="text-black text-lg opacity-90 mb-4 font-medium">เป็นเจ้าของห้องและเชิญเพื่อนมาเล่นด้วยกัน</p>
      </div>
      <a href="/create-room" class="bg-gradient-to-r from-[#ff6a6a] to-[#ff8c42] hover:from-[#ff4d4d] hover:to-[#ff6a00] hover:scale-105 text-white cursor-pointer font-bold px-8 py-3 rounded-2xl inline-block text-lg transition-all duration-300 ease-out">
        <i class="fa-solid fa-plus"></i> สร้างห้อง
      </a>
    </div>
  </div>
</div>

<!-- Available Rooms Section -->
<div class="container mx-auto px-4">
  <% if (error) { %>
    <div class="bg-red-100 text-red-700 px-4 py-2 rounded mb-4 w-full text-center"><%= error %></div>
  <% } %>
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (rooms && rooms.length > 0) { %>
      <% rooms.forEach(function(room) { %>
        <div class="bg-white rounded-3xl p-6 shadow-lg card-hover border border-purple-100 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xl font-bold text-purple-800"><%= room.name %></h3>
              <span class="bg-orange-100 text-orange-600 px-3 py-1 rounded-full text-sm font-semibold"><%= room.is_private ? 'ส่วนตัว' : 'สาธารณะ' %></span>
            </div>
            <div class="flex items-center mb-4">
              <div class="w-10 h-10" style="background: <%= room.room_color %>; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 0.75rem;">
                <span class="text-white font-bold text-lg">🏠</span>
              </div>
              <div>
                <p class="text-purple-800 font-medium">เจ้าของห้อง: <%= room.owner_name %></p>
                <p class="text-gray-500 text-sm">👥 0/<%= room.max_players %> ผู้เล่น</p>
              </div>
            </div>
          </div>
          <button class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-xl transition-colors mt-2">
            เข้าร่วมห้อง
          </button>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-span-full text-center text-gray-500 py-12 text-lg">ยังไม่มีห้องที่เปิดอยู่ในขณะนี้</div>
    <% } %>
  </div>
</div>
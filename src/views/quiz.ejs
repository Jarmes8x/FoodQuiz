<!-- Create Room Section -->
<div class="container mx-auto px-4 mb-12">
  <div
    class="bg-gradient-to-br from-green-500 via-emerald-500 to-teal-400 rounded-3xl p-10 text-white relative overflow-hidden shadow-2xl animate-fadeInUp">
    <!-- Floating shapes -->
    <div class="floating-shapes">
      <span class="floating-emoji emoji-1">🌱</span>
      <span class="floating-emoji emoji-2">🍀</span>
      <span class="floating-emoji emoji-3">🥑</span>
      <span class="floating-emoji emoji-4">🍉</span>
    </div>
    <div class="absolute top-4 right-4 text-6xl opacity-20 select-none pointer-events-none">➕</div>
    <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex flex-col gap-4">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-2 text-shadow">เลือกห้องสำหรับตอบคำถาม</h2>
        <p class="text-lg opacity-90 mb-4 font-medium">เป็นเจ้าของห้องและเชิญเพื่อนมาเล่นด้วยกัน</p>
      </div>
      <button id="openCreateRoomModal"
        class="bg-gradient-to-r from-white via-green-100 to-emerald-200 text-green-700 hover:from-emerald-100 hover:to-white font-extrabold px-10 py-4 rounded-2xl btn-3d transition-all flex items-center gap-2 shadow-lg text-lg">
        <span class="text-2xl">➕</span> สร้างห้อง
      </button>
    </div>
  </div>
</div>

<!-- Create Room Modal -->
<div id="createRoomModal" class="fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50 hidden">
  <div class="bg-white rounded-3xl shadow-2xl p-8 w-full max-w-md relative animate-fadeInUp">
    <button id="closeCreateRoomModal"
      class="absolute top-4 right-4 text-gray-400 hover:text-red-400 text-2xl font-bold">&times;</button>
    <h3 class="text-2xl font-bold mb-6 text-green-700 flex items-center gap-2"><span>➕</span> สร้างห้องใหม่</h3>
    <form id="createRoomForm" class="flex flex-col gap-5">
      <div>
        <label class="block text-gray-700 font-semibold mb-1">ชื่อห้อง</label>
        <input type="text" name="roomName" placeholder="ชื่อห้อง"
          class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-emerald-400 outline-none"
          required>
      </div>
      <div>
        <label class="block text-gray-700 font-semibold mb-1">โหมดเกม</label>
        <select name="gameMode"
          class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-emerald-400 outline-none">
          <option value="speed">โหมดเร็ว (ง่าย)</option>
          <option value="champion">โหมดแชมป์ (ยาก)</option>
        </select>
      </div>
      <div class="flex justify-end gap-2 mt-2">
        <button type="button" id="cancelCreateRoom"
          class="px-6 py-2 rounded-xl bg-gray-100 text-gray-600 font-semibold hover:bg-gray-200">ยกเลิก</button>
        <button type="submit"
          class="px-8 py-2 rounded-xl bg-gradient-to-r from-green-500 to-emerald-500 text-white font-bold shadow btn-3d hover:from-emerald-600 hover:to-green-600">สร้างห้อง</button>
      </div>
    </form>
  </div>
</div>

<!-- Available Rooms Section -->
<div class="container mx-auto px-4">
  <!-- Room Cards Grid -->
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Room 1 - Speed Mode -->
    <div class="bg-white rounded-3xl p-6 shadow-lg card-hover animate-slideInLeft border border-gray-100">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xl font-bold text-gray-800">ห้องผู้เริ่มต้น</h3>
        <span class="bg-blue-100 text-blue-600 px-3 py-1 rounded-full text-sm font-semibold">โหมดเร็ว</span>
      </div>
      <div class="flex items-center mb-4">
        <div
          class="w-10 h-10 bg-gradient-to-br from-blue-400 to-blue-600 rounded-full flex items-center justify-center mr-3">
          <span class="text-white font-bold">⚡</span>
        </div>
        <div>
          <p class="text-gray-800 font-medium">เจ้าของห้อง: สมชาย</p>
          <p class="text-gray-500 text-sm">👥 3/6 ผู้เล่น</p>
        </div>
      </div>
      <button class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 rounded-xl transition-colors">
        เข้าร่วมห้อง
      </button>
    </div>

  </div>
</div>

<!-- Refresh Section -->
<div class="container mx-auto px-4 mb-12 text-center">
  <button
    class="bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-bold px-8 py-3 rounded-xl hover:shadow-lg transition-all btn-3d">
    🔄 รีเฟรชห้อง
  </button>
</div>

<script>
  // Intersection Observer for animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, observerOptions);

  // Observe all animated elements
  document.querySelectorAll('.animate-fadeInUp, .animate-slideInLeft').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(30px)';
    observer.observe(el);
  });

  // Add click effects to room cards
  document.querySelectorAll('.card-hover').forEach(card => {
    card.addEventListener('click', function () {
      if (!this.querySelector('button[disabled]')) {
        this.style.transform = 'scale(0.95)';
        setTimeout(() => {
          this.style.transform = '';
        }, 150);
      }
    });
  });

  // Random floating animation delays for emojis
  document.querySelectorAll('.floating-emoji').forEach((emoji, index) => {
    emoji.style.animationDelay = (Math.random() * 8) + 's';
  });

  // Add functionality to create room button
  document.querySelector('.bg-green-600 button').addEventListener('click', function () {
    const roomName = document.querySelector('input[placeholder="ชื่อห้อง"]').value;
    const gameMode = document.querySelector('select').value;

    if (roomName.trim() === '') {
      alert('กรุณาใส่ชื่อห้อง');
      return;
    }

    // Here you would typically send the data to your backend
    alert(`สร้างห้อง "${roomName}" (${gameMode === 'speed' ? 'โหมดเร็ว' : 'โหมดแชมป์'}) สำเร็จ!`);
  });

  // Add functionality to join room buttons
  document.querySelectorAll('button:not([disabled]):not(.bg-green-600 button):not(.bg-gradient-to-r button)').forEach(button => {
    button.addEventListener('click', function () {
      const roomCard = this.closest('.bg-white');
      const roomName = roomCard.querySelector('h3').textContent;

      // Here you would typically redirect to the game room
      alert(`เข้าร่วม "${roomName}" สำเร็จ!`);
    });
  });

  // Auto-refresh rooms every 30 seconds
  setInterval(() => {
    // Here you would typically fetch updated room data from your backend
    console.log('Refreshing rooms...');
  }, 30000);

  // Modal logic for create room
  const openModalBtn = document.getElementById('openCreateRoomModal');
  const modal = document.getElementById('createRoomModal');
  const closeModalBtn = document.getElementById('closeCreateRoomModal');
  const cancelCreateRoom = document.getElementById('cancelCreateRoom');

  openModalBtn.addEventListener('click', () => {
    modal.classList.remove('hidden');
  });
  closeModalBtn.addEventListener('click', () => {
    modal.classList.add('hidden');
  });
  cancelCreateRoom.addEventListener('click', () => {
    modal.classList.add('hidden');
  });

  // Handle form submit
  const createRoomForm = document.getElementById('createRoomForm');
  createRoomForm.addEventListener('submit', function (e) {
    e.preventDefault();
    const roomName = this.roomName.value.trim();
    const gameMode = this.gameMode.value;
    if (!roomName) {
      alert('กรุณาใส่ชื่อห้อง');
      return;
    }
    // TODO: ส่งข้อมูลไป backend
    alert(`สร้างห้อง "${roomName}" (${gameMode === 'speed' ? 'โหมดเร็ว' : 'โหมดแชมป์'}) สำเร็จ!`);
    modal.classList.add('hidden');
    this.reset();
  });
</script>


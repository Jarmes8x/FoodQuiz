<!-- Create Room Section -->
<div class="container mx-auto px-4 mb-12 mt-6">
  <div class="bg-gradient-to-br bg-white via-blue-100 rounded-3xl p-10 text-white relative overflow-hidden shadow-2xl">
    <!-- Floating shapes -->
    <div class="pointer-events-none select-none">
      <span class="absolute text-2xl top-2 left-1/2">🌱</span>
      <span class="absolute text-2xl top-1/3 left-1/5">🍀</span>
      <span class="absolute text-2xl top-2/3 left-2/3">🥑</span>
      <span class="absolute text-2xl top-3/6 left-4/5">🍉</span>
      <span class="absolute top-4 right-4 text-6xl opacity-20 select-none pointer-events-none">➕</span>
    </div>
    <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex flex-col gap-4">
        <h2 class="text-black text-3xl md:text-4xl font-extrabold mb-2 text-shadow">เลือกห้องสำหรับเล่นเกมตอบคำถาม</h2>
        <p class="text-black text-lg opacity-90 mb-4 font-medium">เป็นเจ้าของห้องและเชิญเพื่อนมาเล่นด้วยกัน</p>
      </div>
      <% if (user.room_id) { %>
        <a href="/edit-room" class="bg-gradient-to-r from-[#ff6a6a] to-[#ff8c42] hover:from-[#ff4d4d] hover:to-[#ff6a00] hover:scale-105 text-white cursor-pointer font-bold px-8 py-3 rounded-2xl inline-block text-lg transition-all duration-300 ease-out">
          <i class="fa-solid fa-edit"></i> แก้ไขห้อง
        </a>
      <% } else { %>
        <a href="/create-room" class="bg-gradient-to-r from-[#ff6a6a] to-[#ff8c42] hover:from-[#ff4d4d] hover:to-[#ff6a00] hover:scale-105 text-white cursor-pointer font-bold px-8 py-3 rounded-2xl inline-block text-lg transition-all duration-300 ease-out">
          <i class="fa-solid fa-plus"></i> สร้างห้อง
        </a>
      <% } %>
    </div>
  </div>
</div>

<!-- Available Rooms Section -->
<div class="container mx-auto px-4">
  <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-6 py-4 rounded-2xl mb-8 w-full text-center font-medium">
      <%= error %>
    </div>
  <% } %>
  
  <!-- Room Full Message -->
  <div id="room-full-message" class="bg-red-50 border border-red-200 text-red-800 px-6 py-4 rounded-2xl mb-8 w-full text-center font-medium" style="display: none;">
    <i class="fa-solid fa-exclamation-triangle mr-2"></i>
    ห้องที่คุณพยายามเข้าร่วมเต็มแล้ว กรุณารอให้มีคนออกจากห้องก่อน
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-8">
    <% if (rooms && rooms.length > 0) { %>
      <% rooms.forEach(function(room) { %>
        <div class="group bg-white rounded-3xl shadow-lg hover:shadow-2xl border-2 transition-all duration-500 overflow-hidden <%= room.owner_name == user.name ? 'border-amber-400' : 'border-gray-100 hover:border-blue-200' %>">
          <!-- Header with room color -->
          <div class="p-6 relative" style="background-color: <%= room.room_color %>;">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <div class="w-3 h-3 rounded-full border-2 border-white shadow bg-black"></div>
                <h3 class="text-xl font-bold text-gray-900 truncate drop-shadow-sm"><%= room.name %></h3>
              </div>
              <span class="<%= room.is_private ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200' %> px-3 py-1 rounded-full text-xs font-semibold border shadow-sm">
                <%= room.is_private ? 'Private' : 'Public' %>
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="px-6 pb-6 pt-6">
            <div class="flex items-center space-x-4 mb-6">
              <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl shadow bg-gradient-to-br from-white via-blue-50 to-blue-100 border border-blue-100 transition-transform duration-300">
                🎮
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-gray-700 font-semibold text-base mb-1">
                  เจ้าของห้อง: <%= room.owner_name %>
                </p>
                <p class="text-gray-500 text-sm flex items-center">
                  <span class="w-2 h-2 bg-green-400 rounded-full mr-2"></span>
                  <span class="player-count font-bold text-blue-700" data-room-id="<%= room.id %>" data-max-players="<%= room.max_players %>">0</span>/<%= room.max_players %> players
                </p>
                <p class="text-xs text-gray-400 mt-1">
                  <i class="fa-solid fa-users mr-1"></i>สูงสุด <%= room.max_players %> คน
                </p>
                <div class="room-status mt-2" data-room-id="<%= room.id %>">
                  <!-- สถานะห้องจะถูกอัปเดตด้วย JavaScript -->
                </div>
              </div>
            </div>

            <!-- Join button -->
            <button id="join-btn-<%= room.id %>" class="<%= (room.owner_name == user.name) ? 'bg-gradient-to-r from-[#ff6a6a] to-[#ff8c42] hover:from-[#ff4d4d] hover:to-[#ff6a00] owner-room' : 'bg-purple-600 hover:bg-purple-700' %> cursor-pointer w-full text-white font-bold px-8 py-4 rounded-2xl text-lg transition-all duration-300 ease-out mt-4 shadow-lg flex items-center justify-center gap-2" 
              onclick="joinRoom('<%= room.id %>', '<%= room.owner_name %>', '<%= user.name %>')">
              <% if (room.owner_name == user.name) { %>
                <i class="fa-solid fa-play"></i>ดำเนินการห้องต่อ
              <% } else { %>
                <i class="fa-solid fa-arrow-right-to-bracket mr-2"></i> เข้าร่วมเกม
              <% } %>
            </button>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-span-full">
        <div class="text-center py-20">
          <div class="w-20 h-20 bg-gradient-to-tr from-pink-100 via-yellow-100 to-blue-100 rounded-full flex items-center justify-center mx-auto mb-8 shadow-lg">
            <svg class="w-10 h-10 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3">ยังไม่มีห้องเกมในขณะนี้</h3>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  // ตัวแปรสำหรับเก็บข้อมูล
  const socket = io();
  const fetchControllers = {};

  // ฟังก์ชันหลักสำหรับเข้าร่วมห้อง
  function joinRoom(roomId, ownerName, userName) {
    // ถ้าเป็นเจ้าของห้อง ให้เข้าร่วมได้เลย
    if (ownerName === userName) {
      window.location.href = `/game-room/${roomId}`;
      return;
    }

    // ตรวจสอบสถานะห้องก่อนเข้าร่วม
    checkRoomStatus(roomId);
  }

  // ฟังก์ชันตรวจสอบสถานะห้อง
  async function checkRoomStatus(roomId) {
    try {
      const response = await fetch(`/api/room-status/${roomId}`);
      const roomData = await response.json();
      
      if (roomData.status === 'process') {
        showMessage('ห้องกำลังเล่นอยู่!', 'กรุณารอให้เกมจบก่อนเข้าร่วม', 'orange');
        return;
      }
      
      // ตรวจสอบจำนวนผู้เล่น
      const playerCountEl = document.querySelector(`[data-room-id="${roomId}"]`);
      const maxPlayers = parseInt(playerCountEl.dataset.maxPlayers);
      const currentCount = parseInt(playerCountEl.textContent);

      if (currentCount >= maxPlayers) {
        showMessage('ห้องเต็มแล้ว!', 'กรุณารอให้มีคนออกจากห้องก่อน', 'red');
        return;
      }

      // เข้าร่วมห้องได้
      window.location.href = `/game-room/${roomId}`;
      
    } catch (error) {
      console.error('Error checking room status:', error);
      // ถ้าไม่สามารถตรวจสอบได้ ให้ใช้การตรวจสอบแบบเดิม
      const playerCountEl = document.querySelector(`[data-room-id="${roomId}"]`);
      const maxPlayers = parseInt(playerCountEl.dataset.maxPlayers);
      const currentCount = parseInt(playerCountEl.textContent);

      if (currentCount >= maxPlayers) {
        showMessage('ห้องเต็มแล้ว!', 'กรุณารอให้มีคนออกจากห้องก่อน', 'red');
        return;
      }

      window.location.href = `/game-room/${roomId}`;
    }
  }

  // ฟังก์ชันแสดงข้อความแจ้งเตือน
  function showMessage(title, message, type) {
    const colors = {
      red: 'bg-red-100 border-red-400 text-red-700',
      orange: 'bg-orange-100 border-orange-400 text-orange-700'
    };
    
    const icons = {
      red: 'fa-exclamation-triangle',
      orange: 'fa-gamepad'
    };

    const messageDiv = document.createElement('div');
    messageDiv.className = `fixed top-4 right-4 border px-4 py-3 rounded-lg shadow-lg z-50 max-w-sm ${colors[type]}`;
    messageDiv.innerHTML = `
      <div class="flex items-center gap-2">
        <i class="fa-solid ${icons[type]}"></i>
        <div>
          <div class="font-bold">${title}</div>
          <div class="text-sm">${message}</div>
        </div>
        <button onclick="this.parentElement.parentElement.remove()" class="ml-auto">
          <i class="fa-solid fa-times"></i>
        </button>
      </div>
    `;
    
    document.body.appendChild(messageDiv);
    
    // ลบข้อความอัตโนมัติหลังจาก 5 วินาที
    setTimeout(() => {
      if (messageDiv.parentElement) {
        messageDiv.remove();
      }
    }, 5000);
  }

  // ฟังก์ชันอัปเดตจำนวนผู้เล่น
  async function updatePlayerCount(roomId, element, maxPlayers) {
    try {
      // ยกเลิก request เดิมถ้ายังไม่เสร็จ
      if (fetchControllers[roomId]) {
        fetchControllers[roomId].abort();
      }

      const controller = new AbortController();
      fetchControllers[roomId] = controller;

      const response = await fetch(`/api/room-players/${roomId}`, { signal: controller.signal });
      const players = await response.json();
      
      element.textContent = players.length;
      updateRoomStatus(roomId, players.length, maxPlayers);
      
    } catch (error) {
      if (error.name !== 'AbortError') {
        console.error(`Error fetching players for room ${roomId}:`, error);
      }
    }
  }

  // ฟังก์ชันอัปเดตสถานะห้อง
  async function updateRoomStatus(roomId, currentCount, maxCount) {
    const statusEl = document.querySelector(`.room-status[data-room-id="${roomId}"]`);
    const joinBtn = document.getElementById(`join-btn-${roomId}`);
    
    try {
      const response = await fetch(`/api/room-status/${roomId}`);
      const roomData = await response.json();
      const roomStatus = roomData.status;
      
      updateRoomUI(statusEl, joinBtn, roomStatus, currentCount, maxCount);
      
    } catch (error) {
      console.error(`Error fetching room status for room ${roomId}:`, error);
      // ถ้าไม่สามารถดึงสถานะได้ ให้ใช้การตรวจสอบแบบเดิม
      updateRoomUI(statusEl, joinBtn, 'waiting', currentCount, maxCount);
    }
  }

  // ฟังก์ชันอัปเดต UI ของห้อง
  function updateRoomUI(statusEl, joinBtn, roomStatus, currentCount, maxCount) {
    if (roomStatus === 'process') {
      // ห้องกำลังเล่นอยู่
      if (statusEl) {
        statusEl.innerHTML = `
          <div class="flex items-center gap-2 text-orange-600 text-sm font-medium">
            <i class="fa-solid fa-gamepad"></i>
            <span>กำลังเล่นอยู่</span>
          </div>
        `;
      }
      
      if (joinBtn && !joinBtn.classList.contains('owner-room')) {
        disableJoinButton(joinBtn, 'ห้องเริ่มเกมไปแล้ว', 'fa-play');
      }
      
    } else if (currentCount >= maxCount) {
      // ห้องเต็ม
      if (statusEl) {
        statusEl.innerHTML = `
          <div class="flex items-center gap-2 text-red-600 text-sm font-medium">
            <i class="fa-solid fa-exclamation-triangle"></i>
            <span>ห้องเต็มแล้ว</span>
          </div>
        `;
      }
      
      if (joinBtn && !joinBtn.classList.contains('owner-room')) {
        disableJoinButton(joinBtn, 'ห้องเต็ม', 'fa-lock');
      }
      
    } else {
      // ห้องยังไม่เต็มและไม่กำลังเล่น
      if (statusEl) {
        statusEl.innerHTML = `
          <div class="flex items-center gap-2 text-green-600 text-sm font-medium">
            <i class="fa-solid fa-check-circle"></i>
            <span>พร้อมเข้าร่วม</span>
          </div>
        `;
      }
      
      if (joinBtn) {
        enableJoinButton(joinBtn);
      }
    }
  }

  // ฟังก์ชันปิดการใช้งานปุ่มเข้าร่วม
  function disableJoinButton(button, text, icon) {
    button.disabled = true;
    button.classList.add('opacity-50', 'cursor-not-allowed');
    button.classList.remove('hover:from-[#ff4d4d]', 'hover:to-[#ff6a00]', 'hover:bg-purple-700');
    button.innerHTML = `<i class="fa-solid ${icon} mr-2"></i>${text}`;
  }

  // ฟังก์ชันเปิดการใช้งานปุ่มเข้าร่วม
  function enableJoinButton(button) {
    button.disabled = false;
    button.classList.remove('opacity-50', 'cursor-not-allowed');
    button.classList.add('hover:from-[#ff4d4d]', 'hover:to-[#ff6a00]', 'hover:bg-purple-700');
    button.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket mr-2"></i> เข้าร่วมเกม';
  }

  // เมื่อหน้าเว็บโหลดเสร็จ
  document.addEventListener('DOMContentLoaded', () => {
    // ตรวจสอบ URL parameter สำหรับข้อความห้องเต็ม
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('error') === 'room_full') {
      const roomFullMessage = document.getElementById('room-full-message');
      if (roomFullMessage) {
        roomFullMessage.style.display = 'block';
        // ลบ parameter จาก URL
        window.history.replaceState({}, document.title, window.location.pathname);
      }
    }

    // เริ่มต้นการอัปเดตข้อมูลห้อง
    initializeRoomUpdates();
  });

  // ฟังก์ชันเริ่มต้นการอัปเดตข้อมูลห้อง
  function initializeRoomUpdates() {
    const playerCountElements = document.querySelectorAll('.player-count');

    playerCountElements.forEach(el => {
      const roomId = el.dataset.roomId;
      const maxPlayers = parseInt(el.dataset.maxPlayers);

      // โหลดข้อมูลครั้งแรก
      updatePlayerCount(roomId, el, maxPlayers);

      // อัปเดตทุก 5 วินาที
      setInterval(() => {
        updatePlayerCount(roomId, el, maxPlayers);
      }, 5000);
    });
  }

  // ฟังก์ชันสำหรับเจ้าของห้องเริ่มเกม
  function startGame(roomId, ownerId) {
    socket.emit('start_game', roomId, ownerId);
  }

  // รับ event select_questions (เฉพาะเจ้าของห้อง)
  socket.on('select_questions', function(questions) {
    showQuestionSelectionModal(questions);
  });

  // ฟังก์ชันแสดง modal เลือกคำถาม
  function showQuestionSelectionModal(questions) {
    let html = '<div class="modal"><h3>เลือกคำถามสำหรับเกมนี้</h3><ul>';
    questions.forEach((q, idx) => {
      html += `<li>${idx + 1}. ${q.question_text}</li>`;
    });
    html += '</ul><button onclick="confirmQuestions()">ยืนยัน</button></div>';
    document.body.insertAdjacentHTML('beforeend', html);
  }

  // ฟังก์ชันยืนยันการเลือกคำถาม
  function confirmQuestions() {
    // ส่ง event ไป backend ว่าเลือกคำถามชุดนี้
    // socket.emit('questions_selected', questions);
    // ปิด modal
    const modal = document.querySelector('.modal');
    if (modal) {
      modal.remove();
    }
  }
</script>
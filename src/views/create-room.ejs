<div class="container mx-auto px-4 mb-12 mt-6">
  <div class="relative bg-gradient-to-br from-blue-50 via-purple-100 to-pink-50 rounded-3xl p-0 shadow-2xl overflow-hidden">
    <!-- Decorative shapes -->
    <div class="absolute inset-0 pointer-events-none select-none z-0">
      <span class="absolute text-4xl top-4 left-1/4 animate-bounce">🌱</span>
      <span class="absolute text-3xl top-1/2 left-1/6 animate-pulse">🍀</span>
      <span class="absolute text-5xl bottom-8 right-1/4 animate-spin-slow">🥑</span>
      <span class="absolute text-4xl bottom-4 right-8 animate-bounce">🍉</span>
      <span class="absolute top-8 right-8 text-7xl opacity-10 select-none pointer-events-none">➕</span>
    </div>
    <div class="relative z-10 flex flex-col items-center justify-center gap-6 py-12 px-6 md:px-16">
      <h2 class="text-4xl md:text-5xl font-extrabold mb-2 text-purple-800 drop-shadow-lg flex items-center gap-2">
        สร้างห้องของคุณ
      </h2>
      <p class="text-lg text-gray-700 mb-4 font-medium">ตั้งค่าห้องของคุณและเชิญเพื่อนมาเล่นด้วยกัน!</p>
      <% if (error) { %>
        <div class="bg-red-100 text-red-700 px-4 py-2 rounded mb-4 w-full max-w-md text-center shadow"> <%= error %> </div>
      <% } %>
      <% if (room) { %>
        <div class="bg-yellow-100 text-yellow-800 px-4 py-2 rounded mb-4 w-full max-w-md text-center shadow">
          คุณมีห้องอยู่แล้ว: <strong><%= room.name %></strong><br>
          หากต้องการสร้างห้องใหม่ กรุณาลบห้องเดิมก่อน
        </div>
        <div class="w-full max-w-md flex flex-col items-center bg-white/80 rounded-xl p-6 shadow gap-2">
          <div class="mb-2 text-lg">ชื่อห้อง: <span class="font-bold text-purple-700"><%= room.name %></span></div>
          <div class="mb-2">จำนวนผู้เล่นสูงสุด: <span class="font-semibold"><%= room.max_players %></span></div>
          <div class="mb-2">ประเภท: <span class="font-semibold"><%= room.is_private ? 'ส่วนตัว' : 'สาธารณะ' %></span></div>
          <div class="mb-2 flex items-center gap-2">สีห้อง: <span style="display:inline-block;width:24px;height:24px;background:<%= room.room_color %>;border-radius:5px;vertical-align:middle;"></span></div>
          <!-- ปุ่มลบห้อง -->
          <form action="/room/<%= room.id %>?_method=DELETE" method="POST" onsubmit="return confirm('คุณต้องการลบห้องนี้จริงหรือไม่?');" class="mt-4 w-full flex justify-center">
            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white font-bold px-6 py-2 rounded-xl text-base transition-all duration-200 shadow flex items-center gap-2">
              <i class="fa-solid fa-trash"></i> ลบห้อง
            </button>
          </form>
        </div>
      <% } else { %>
        <form action="/create-room" method="POST" class="w-full max-w-md flex flex-col gap-5 bg-white/80 rounded-xl p-8 shadow-lg mt-2">
          <label class="font-medium text-gray-700">ชื่อห้อง
            <input type="text" name="name" value="ห้องของ <%= user.name %>" class="mt-1 p-3 px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-purple-400 transition w-full" required>
          </label>
          <label class="font-medium text-gray-700">จำนวนผู้เล่นสูงสุด
            <div class="mt-1 flex items-center gap-2">
              <input type="number" name="max_players" id="max_players_input" class="flex-1 p-3 px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-purple-400 transition" min="2" max="10" value="5">
              <div class="flex flex-col gap-1">
                <button type="button" onclick="adjustMaxPlayers(1)" class="w-8 h-8 bg-purple-100 hover:bg-purple-200 text-purple-700 rounded-lg border border-purple-300 flex items-center justify-center transition-colors">
                  <i class="fa-solid fa-plus text-xs"></i>
                </button>
                <button type="button" onclick="adjustMaxPlayers(-1)" class="w-8 h-8 bg-purple-100 hover:bg-purple-200 text-purple-700 rounded-lg border border-purple-300 flex items-center justify-center transition-colors">
                  <i class="fa-solid fa-minus text-xs"></i>
                </button>
              </div>
            </div>
            <span class="text-xs text-gray-500">* จำนวนผู้เล่นที่สามารถเข้าร่วมได้ (2-10 คน)</span>
          </label>
          <label class="font-medium flex items-center gap-2 text-gray-700">
            <input type="checkbox" name="is_private" value="1" id="is_private_checkbox" class="accent-purple-500"> ห้องส่วนตัว (ไม่บังคับ)
          </label>
          <label class="font-medium text-gray-700" id="password_label" style="display:none;">รหัสผ่าน (ไม่บังคับ)
            <input type="text" name="password" class="mt-1 p-3 px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-purple-400 transition w-full">
          </label>
          <div class="font-medium text-gray-700">
            <label>สีห้อง</label>
            <div class="mt-2 grid grid-cols-5 gap-2">
              <input type="radio" name="room_color" value="#a0e7e5" id="color2" class="hidden">
              <label for="color2" class="w-10 h-10 bg-[#a0e7e5] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
                <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
              </label>
              
              <input type="radio" name="room_color" value="#ffadad" id="color1" class="hidden">
              <label for="color1" class="w-10 h-10 bg-[#ffadad] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
                <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
              </label>

              <input type="radio" name="room_color" value="#b5ead7" id="color3" class="hidden">
              <label for="color3" class="w-10 h-10 bg-[#b5ead7] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
                <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
              </label>

              <input type="radio" name="room_color" value="#fdfd96" id="color4" class="hidden">
              <label for="color4" class="w-10 h-10 bg-[#fdfd96] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
                <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
              </label>

              <input type="radio" name="room_color" value="#ffd6a5" id="color5" class="hidden">
              <label for="color5" class="w-10 h-10 bg-[#ffd6a5] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
                <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
              </label>

              <input type="radio" name="room_color" value="#cdb4db" id="color6" class="hidden">
              <label for="color6" class="w-10 h-10 bg-[#cdb4db] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
                <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
              </label>

              <input type="radio" name="room_color" value="#ffb7c5" id="color7" class="hidden">
              <label for="color7" class="w-10 h-10 bg-[#ffb7c5] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
                <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
              </label>

              <input type="radio" name="room_color" value="#ffdac1" id="color9" class="hidden">
              <label for="color9" class="w-10 h-10 bg-[#ffdac1] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
                <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
              </label>

              <input type="radio" name="room_color" value="#d0f4de" id="color8" class="hidden">
              <label for="color8" class="w-10 h-10 bg-[#d0f4de] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
                <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
              </label>
            </div>
          </div>
          <div class="text-sm text-purple-700 bg-purple-50 rounded-lg px-4 py-2 mb-2">
            <i class="fa-solid fa-info-circle"></i> ผู้สร้างห้องจะไม่สามารถเข้าร่วมเล่นเกมในห้องนี้ แต่จะสามารถเลือกคำถามและควบคุมเกมได้
          </div>
          <button type="submit" class="cursor-pointer bg-purple-600 hover:bg-purple-700 text-white font-bold px-8 py-3 rounded-2xl text-lg transition-all duration-300 ease-out mt-4 shadow-lg flex items-center justify-center gap-2">
            <i class="fa-solid fa-plus"></i> สร้างห้อง
          </button>
          <a href="/quiz"
            class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold px-8 py-3 rounded-2xl text-lg transition-all duration-300 ease-out text-center shadow-lg flex items-center justify-center gap-2">
            <i class="fa-solid fa-times"></i> ยกเลิก
          </a>
        </form>
      <% } %>
    </div>
  </div>
</div> 

<script>
  // จัดการการเลือกสี
  const colorInputs = document.querySelectorAll('input[name="room_color"]');
  const checkIcons = document.querySelectorAll('.check-icon');

  colorInputs.forEach((input, index) => {
    input.addEventListener('change', function () {
      // ซ่อนเช็คทั้งหมด
      checkIcons.forEach(icon => {
        icon.style.opacity = '0';
        icon.parentElement.classList.remove('border-gray-600');
      });

      // แสดงเช็คที่เลือก
      if (this.checked) {
        checkIcons[index].style.opacity = '1';
        checkIcons[index].parentElement.classList.add('border-gray-600');
      }
    });
  });

  // ตั้งค่าเริ่มต้น (เลือกสีแรก)
  colorInputs[0].checked = true;
  checkIcons[0].style.opacity = '1';
  checkIcons[0].parentElement.classList.add('border-gray-600');

  // แสดง/ซ่อนช่องรหัสผ่านตาม checkbox ห้องส่วนตัว
  const isPrivateCheckbox = document.getElementById('is_private_checkbox');
  const passwordLabel = document.getElementById('password_label');
  isPrivateCheckbox.addEventListener('change', function() {
    if (this.checked) {
      passwordLabel.style.display = '';
    } else {
      passwordLabel.style.display = 'none';
    }
  });

  // ฟังก์ชันปรับจำนวนผู้เล่นสูงสุด
  function adjustMaxPlayers(change) {
    const input = document.getElementById('max_players_input');
    const currentValue = parseInt(input.value) || 5;
    const newValue = Math.max(2, Math.min(10, currentValue + change));
    input.value = newValue;
  }
</script>
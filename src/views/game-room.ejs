<script>
  const user = <%- JSON.stringify({ id: user.id, name: user.name }) %>;
  const isOwner = <%= user.id === room.creator_id ? 'true' : 'false' %>;
  let questions = <%- JSON.stringify(questions) %>;
  const roomId = "<%= room.id %>";
  const playerFoods = <%- JSON.stringify(playerFoods || {}) %>;
</script>
<div class="container mx-auto px-4 py-8">
  <h2 class="text-2xl font-bold mb-4 text-center">ห้อง: <%= room.name %></h2>
  <!-- Modal แสดงอาหารที่สุ่มได้ -->
  <div id="food-modal" class="fixed inset-0 bg-black/40 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-2xl p-8 max-w-xs w-full text-center">
      <h3 class="text-xl font-bold mb-4 text-purple-700">อาหารที่คุณได้รับ</h3>
      <div id="food-modal-content" class="text-2xl font-bold text-green-700 mb-4"></div>
      <button id="close-food-modal" class="bg-purple-500 hover:bg-purple-700 text-white font-bold px-6 py-2 rounded-xl">ปิด</button>
    </div>
  </div>
  <!-- Modal แสดงวัตถุดิบทั้งหมด -->
  <div id="ingredient-modal" class="fixed inset-0 bg-black/40 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-2xl p-8 max-w-md w-full text-center">
      <h3 class="text-xl font-bold mb-4 text-yellow-700">วัตถุดิบทั้งหมดในเกม</h3>
      <div id="ingredient-modal-content" class="mb-4 grid grid-cols-2 md:grid-cols-3 gap-2">
        <% if (typeof ingredients !== 'undefined' && Array.isArray(ingredients)) { %>
          <% ingredients.forEach(function(ing) { %>
            <div class="flex flex-col items-center bg-yellow-100 rounded-xl px-4 py-2 font-bold">
              <div class="w-12 h-12 bg-white rounded-xl mb-1 flex items-center justify-center overflow-hidden border border-yellow-200">
                <% if (ing.image_file) { %>
                  <img src="/img/<%= ing.image_file %>" 
                      alt="<%= ing.name %>" 
                      class="object-cover w-full h-full" 
                      loading="lazy"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                  <div style="display:none;" class="flex items-center justify-center">
                    <i class="fa-solid fa-utensils text-yellow-400 text-lg"></i>
                  </div>
                <% } else { %>
                  <span class="text-2xl text-yellow-300">
                    <i class="fa-solid fa-carrot"></i>
                  </span>
                <% } %>
              </div>
              <span><%= ing.name %> (<%= ing.price %> แต้ม)</span>
            </div>
          <% }); %>
        <% } %>
      </div>
      <button id="close-ingredient-modal" class="bg-yellow-500 hover:bg-yellow-700 text-white font-bold px-6 py-2 rounded-xl">ปิด</button>
    </div>
  </div>
  <div class="flex flex-col md:flex-row gap-6 mb-6">
    <div class="flex-1 bg-white rounded-2xl shadow p-6">
      <h3 class="text-lg font-semibold mb-2">ผู้เล่นในห้อง (<span id="player-count"><%= players.length %></span>/<%= room.max_players %>)</h3>
      <ul id="player-list">
        <% players.forEach(function(player) { %>
          <li class="mb-1 <%= player.is_owner ? 'font-bold text-purple-700' : '' %>" id="player-li-<%= player.id %>">
            <i class="fa-solid fa-user"></i> <span class="player-name"><%= player.name %></span> 
            <span class="text-xs text-gray-400"><%= player.is_owner ? '(เจ้าของห้อง)' : '' %></span> 
            <span class="ml-2 text-green-600 font-bold">+<%= player.score %></span>
            <% if (playerFoods[player.id] && playerFoods[player.id].length > 0) { %>
              <div class="mt-1 text-xs text-blue-600">
                <i class="fa-solid fa-utensils mr-1"></i>
                <%= playerFoods[player.id].join(', ') %>
              </div>
            <% } %>
          </li>
        <% }); %>
      </ul>
    </div>
    <div class="flex-1 bg-white rounded-2xl shadow p-6">
      <div id="game-area">
        <!-- ส่วนแสดงคำถามและตัวเลือกจะถูกเติมโดย JS -->
        <div id="waiting-area" class="text-center text-lg text-gray-500">
          <span id="waiting-message">รอเจ้าของห้องเริ่มเกม...</span>
        </div>
      </div>
      <% if (user.id === room.creator_id) { %>
        <button id="start-btn" class="mt-4 bg-gradient-to-r from-[#ff6a6a] to-[#ff8c42] text-white font-bold px-8 py-3 rounded-2xl text-lg w-full">เริ่มเกม</button>
        <button id="next-btn" class="mt-4 bg-gradient-to-r from-[#ff8c42] to-[#ff6a6a] text-white font-bold px-8 py-3 rounded-2xl text-lg w-full hidden">ข้อถัดไป</button>
        <button id="delete-room-btn" class="mt-4 bg-red-500 hover:bg-red-700 text-white font-bold px-8 py-3 rounded-2xl text-lg w-full">ลบห้อง</button>
      <% } %>
    </div>
  </div>
  <div class="bg-white rounded-2xl shadow p-6 mt-6">
    <h3 class="text-lg font-semibold mb-2">คะแนน</h3>
    <ul id="score-list">
      <% players.forEach(function(player) { %>
        <li class="mb-1 <%= player.is_owner ? 'font-bold text-purple-700' : '' %>"><i class="fa-solid fa-user"></i> <%= player.name %> <span class="ml-2 text-green-600 font-bold">+<span id="score-<%= player.id %>"><%= player.score %></span></span></li>
      <% }); %>
    </ul>
    <div id="ingredient-shop" class="mt-8">
      <h3 class="text-lg font-semibold mb-2">ร้านขายวัตถุดิบ</h3>
      <div class="mb-2">แต้มของคุณ: <span id="my-points">0</span></div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-2">
        <% if (typeof ingredients !== 'undefined' && Array.isArray(ingredients) && ingredients.length > 0) { %>
          <% ingredients.forEach(function(ing) { %>
      <div class="flex flex-col items-center bg-yellow-50 rounded-xl p-2 shadow border border-yellow-100">
        <div class="w-14 h-14 bg-white rounded-xl mb-1 flex items-center justify-center overflow-hidden border border-yellow-200">
          <% if (ing.image_file) { %>
            <img src="/img/<%= ing.image_file %>" 
                 alt="<%= ing.name %>" 
                 class="object-cover w-full h-full" 
                 loading="lazy"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
            
            <!-- Fallback icon if image fails -->
            <div style="display:none;" class="flex items-center justify-center">
              <i class="fa-solid fa-utensils text-yellow-400 text-lg"></i>
            </div>
          <% } else { %>
            <!-- No image mapping found -->
            <span class="text-2xl text-yellow-300">
              <i class="fa-solid fa-carrot"></i>
            </span>
          <% } %>
        </div>
        
        <button class="ingredient-btn bg-yellow-100 hover:bg-yellow-200 rounded-xl px-2 py-1 font-bold mt-1 w-full transition-colors duration-200" 
                data-ingredient="<%= ing.name %>">
          <%= ing.name %> (<%= ing.price %> แต้ม)
        </button>
      </div>
    <% }); %>
    
  <% } else { %>
    <div class="col-span-full text-center p-8 bg-gray-100 border-2 border-dashed border-gray-300 rounded-xl flex flex-col items-center justify-center">
      <i class="fa-solid fa-shopping-basket text-gray-400 text-4xl mb-4"></i>
      <p class="text-gray-600 font-semibold">ไม่มีรายการวัตถุดิบ</p>
      <p class="text-gray-500 text-sm mt-2">กรุณาเพิ่มวัตถุดิบในระบบ</p>
      <% /* Show unique ingredient tags from mealIngredients even if shop is empty */ %>
      <% if (typeof mealIngredientRows !== 'undefined' && Array.isArray(mealIngredientRows) && mealIngredientRows.length > 0) { %>
        <% 
          // mealIngredientRows: array of { ingredient: 'xxx', ... }
          let uniqueIngredients = [];
          mealIngredientRows.forEach(function(row) {
            let trimmed = row.ingredient && row.ingredient.trim();
            if (trimmed && !uniqueIngredients.includes(trimmed)) {
              uniqueIngredients.push(trimmed);
            }
          });
          // ใช้ชื่อไฟล์จากฐานข้อมูลแทน
          const ingredientImgMap = {};
        %>
        <div class="mt-4">
          <h4 class="text-md font-bold mb-1 text-blue-700">วัตถุดิบที่ใช้ในสูตรอาหารทั้งหมด</h4>
          <div class="flex flex-wrap gap-2 justify-center">
            <% uniqueIngredients.forEach(function(name) { %>
              <span class="inline-flex items-center bg-blue-100 text-blue-800 rounded-full px-2 py-1 text-sm font-semibold gap-2">
                <span class="w-7 h-7 bg-white rounded-full flex items-center justify-center overflow-hidden border border-blue-200 mr-1">
                  <% const imgIndex = ingredientImgMap[name] || ingredientImgMap[name.trim()]; %>
                  <% if (imgIndex) { %>
                    <img src="/img/<%= imgIndex %>.png" alt="<%= name %>" class="object-cover w-full h-full" loading="lazy"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                    <span style="display:none;" class="flex items-center justify-center"><i class="fa-solid fa-utensils text-blue-400 text-base"></i></span>
                  <% } else { %>
                    <span class="text-base text-blue-300"><i class="fa-solid fa-carrot"></i></span>
                  <% } %>
                </span>
                <%= name %>
              </span>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<div class="mb-4">
  <h4 class="text-md font-bold mb-1 text-green-700">สูตรอาหารที่สามารถทำได้</h4>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% if (typeof mealIngredients !== 'undefined' && Array.isArray(mealIngredients) && mealIngredients.length > 0) { %>
      <% 
        // Map meal name to image index - ใช้รูปเดียวกับวัตถุดิบหลัก
        const mealImgMap = {
          'กะเพราะหมูสับ': 1,
          'ข้าวผัดรถไฟ': 2,
          'ส้มตำ': 3,
          'ผัดเปรี้ยวหวาน': 4,
          'แกงจืดหมูสับ': 5,
          'หมูสับผัดไข่': 6,
          'ไข่ตุ๋นกุ้ง': 7,
          'น้ำพริกอ่องหมูสับ': 8,
          'ยำกุ้งสุก': 9,
          'ไข่เจียวทรงเครื่อง': 10,
        };
      %>
      
      <% mealIngredients.forEach(function(meal) { %>
        <div class="bg-green-50 rounded-xl p-4 flex flex-col items-center shadow border border-green-100 hover:bg-green-100 transition-colors duration-200">
          <div class="w-20 h-20 bg-white rounded-xl mb-2 flex items-center justify-center overflow-hidden border border-green-200">
            <% 
              // ลองหารูปจากชื่ออาหารโดยตรง หรือจากคำในชื่ออาหาร
              let mealImgIndex = mealImgMap[meal.meal_name] || mealImgMap[meal.meal_name.trim()];
              
              // ถ้าไม่เจอ ลองหาจากคำในชื่ออาหาร
              if (!mealImgIndex) {
                Object.keys(mealImgMap).forEach(key => {
                  if (meal.meal_name.includes(key) || key.includes(meal.meal_name)) {
                    mealImgIndex = mealImgMap[key];
                  }
                });
              }
              
              // ถ้ายังไม่เจอ ลองดูจากวัตถุดิบหลัก
              if (!mealImgIndex && meal.ingredients) {
                Object.keys(mealImgMap).forEach(key => {
                  if (meal.ingredients.includes(key)) {
                    mealImgIndex = mealImgMap[key];
                  }
                });
              }
            %>
            
            <% if (mealImgIndex) { %>
              <img src="/img/<%= mealImgIndex %>.png" 
                   alt="<%= meal.meal_name %>" 
                   class="object-cover w-full h-full" 
                   loading="lazy"
                   onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
              
              <!-- Fallback icon if image fails -->
              <div style="display:none;" class="flex items-center justify-center">
                <i class="fa-solid fa-utensils text-green-400 text-2xl"></i>
              </div>
            <% } else { %>
              <!-- No image mapping found - show default icon -->
              <span class="text-4xl text-green-300">
                <i class="fa-solid fa-utensils"></i>
              </span>
            <% } %>
          </div>
          
          <div class="font-bold text-green-800 text-center mb-1"><%= meal.meal_name %></div>
          <div class="text-gray-700 text-xs text-center mb-2">วัตถุดิบ: <%= meal.ingredients %></div>
          
          <!-- เพิ่มปุ่มสำหรับทำอาหาร -->
          <button class="cook-meal-btn bg-green-500 hover:bg-green-600 text-white rounded-lg px-3 py-1 text-xs font-semibold transition-colors duration-200" 
                  data-meal="<%= meal.meal_name %>" 
                  data-ingredients="<%= meal.ingredients %>">
            <i class="fa-solid fa-fire mr-1"></i>ทำอาหาร
          </button>
        </div>
      <% }); %>
      
    <% } else { %>
          <button disabled class="bg-gray-200 rounded-xl px-4 py-2 font-bold">ไม่มีข้อมูลวัตถุดิบ</button>
      </div>
    <% } %>
      <div class="mt-8 flex flex-col items-center">
        <button id="random-food-btn" class="bg-gradient-to-r from-green-400 to-blue-400 text-white font-bold px-8 py-4 rounded-2xl w-full max-w-md text-lg shadow-lg transition-all duration-200 mb-4">สุ่มอาหารจากวัตถุดิบของฉัน</button>
        <div class="w-full max-w-md flex flex-col gap-2 items-start">
          <div class="mb-1 text-base font-semibold">วัตถุดิบของคุณ: <span id="my-ingredients"></span></div>
          <div class="mb-1 text-base font-semibold">อาหารที่คุณได้รับ: <span id="my-food" class="font-bold text-purple-700"></span></div>
        </div>
        
        <!-- แสดงอาหารที่สุ่มได้เมื่อเข้าห้อง -->
        <div class="mt-6 w-full max-w-md">
          <h4 class="text-lg font-bold mb-3 text-center text-purple-700">อาหารที่คุณได้รับเมื่อเข้าห้อง</h4>
          <div id="my-assigned-foods" class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <% if (playerFoods[user.id] && playerFoods[user.id].length > 0) { %>
              <% playerFoods[user.id].forEach(function(food) { %>
                <div class="bg-purple-100 rounded-xl p-3 text-center border border-purple-200">
                  <i class="fa-solid fa-utensils text-purple-600 text-xl mb-2"></i>
                  <div class="font-semibold text-purple-800"><%= food %></div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="col-span-full text-center text-gray-500 py-4">
                <i class="fa-solid fa-clock text-2xl mb-2"></i>
                <div>กำลังสุ่มอาหาร...</div>
              </div>
            <% } %>
          </div>
        </div>
      </div>
  </div>
</div>
</div>
<script src="/socket.io/socket.io.js"></script>
<script>
  // JavaScript สำหรับจัดการปุ่มทำอาหาร
  document.addEventListener('DOMContentLoaded', function() {
    // จัดการปุ่มวัตถุดิบ
    document.querySelectorAll('.ingredient-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const ingredient = this.dataset.ingredient;
        console.log('Selected ingredient:', ingredient);
        // เพิ่มฟังก์ชันการทำงานตามต้องการ
      });
    });
    
    // จัดการปุ่มทำอาหาร
    document.querySelectorAll('.cook-meal-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const meal = this.dataset.meal;
        const ingredients = this.dataset.ingredients;
        console.log('Cooking meal:', meal, 'with ingredients:', ingredients);
        
        // เพิ่มเอฟเฟกต์การทำอาหาร
        this.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i>กำลังทำ...';
        this.disabled = true;
        
        setTimeout(() => {
          this.innerHTML = '<i class="fa-solid fa-check mr-1"></i>ทำเสร็จแล้ว!';
          setTimeout(() => {
            this.innerHTML = '<i class="fa-solid fa-fire mr-1"></i>ทำอาหาร';
            this.disabled = false;
          }, 2000);
        }, 3000);
      });
    });
  });
</script>
<script>
  const socket = io();
  let currentQuestion = 0;
  let answered = false;
  let startTime = null;
  // สำหรับวัตถุดิบและอาหาร
  let myPoints = 0;
  let myIngredients = [];
  let myFood = '';

  // --- Room deleted event ---
  socket.on('room_deleted', function(data) {
    showNotification('ห้องนี้ถูกลบแล้ว', 'info');
    setTimeout(() => {
      window.location.href = '/';
    }, 2000);
  });

  // เมื่อห้องเต็ม
  socket.on('room_full', function(data) {
    showNotification('ห้องเต็มแล้ว', 'info');
    setTimeout(() => {
      window.location.href = '/';
    }, 2000);
  });


  // --- ส่วนฟีเจอร์ซื้อวัตถุดิบและสุ่มอาหาร ---
  function updateMyShopUI() {
    document.getElementById('my-points').textContent = myPoints;
    document.getElementById('my-ingredients').textContent = myIngredients.join(', ') || '-';
    document.getElementById('my-food').textContent = myFood;
  }

  socket.on('update_points_ingredients', data => {
    if (data.userId === user.id) {
      myPoints = data.points;
      myIngredients = data.ingredients || [];
      // ถ้ามีอาหารใหม่ ให้แสดงป๊อบอัพ
      if (data.food && data.food !== '' && data.food !== myFood && data.food !== 'ยังทำอาหารไม่ได้') {
        myFood = data.food;
        updateMyShopUI();
        showFoodModal(myFood);
      } else {
        myFood = data.food || '';
        updateMyShopUI();
      }
    }
  });
  // ฟังก์ชั่นแสดงป๊อบอัพอาหาร
  function showFoodModal(food) {
    const modal = document.getElementById('food-modal');
    const content = document.getElementById('food-modal-content');
    content.textContent = food;
    modal.classList.remove('hidden');
  }
  document.getElementById('close-food-modal').onclick = function() {
    document.getElementById('food-modal').classList.add('hidden');
  };

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.ingredient-btn').forEach(btn => {
      btn.onclick = () => {
        const ing = btn.getAttribute('data-ingredient');
        socket.emit('buy_ingredient', { roomId, userId: user.id, ingredient: ing });
      };
    });
    document.getElementById('random-food-btn').onclick = () => {
      socket.emit('random_food', { roomId, userId: user.id });
    };
    updateMyShopUI();
  });

  // อัปเดตแต้มและวัตถุดิบของฉัน
  function updateMyShopUI() {
    document.getElementById('my-points').textContent = myPoints;
    document.getElementById('my-ingredients').textContent = myIngredients.join(', ') || '-';
    document.getElementById('my-food').textContent = myFood;
  }

  // รับ event อัปเดตแต้ม/วัตถุดิบ (หลังจบเกมหรือซื้อวัตถุดิบ)
  socket.on('update_points_ingredients', data => {
    if (data.userId === user.id) {
      myPoints = data.points;
      myIngredients = data.ingredients || [];
      myFood = data.food || '';
      updateMyShopUI();
    }
  });

  // รับ event อาหารที่สุ่มได้เมื่อเข้าห้อง
  socket.on('foods_assigned', data => {
    if (data.userId === user.id) {
      console.log('Received assigned foods:', data.foods);
      updateAssignedFoodsUI(data.foods);
    }
  });

  // ฟังก์ชันอัปเดต UI แสดงอาหารที่สุ่มได้
  function updateAssignedFoodsUI(foods) {
    const container = document.getElementById('my-assigned-foods');
    if (!container) return;

    if (foods && foods.length > 0) {
      container.innerHTML = foods.map(food => `
        <div class="bg-purple-100 rounded-xl p-3 text-center border border-purple-200">
          <i class="fa-solid fa-utensils text-purple-600 text-xl mb-2"></i>
          <div class="font-semibold text-purple-800">${food}</div>
        </div>
      `).join('');
    } else {
      container.innerHTML = `
        <div class="col-span-full text-center text-gray-500 py-4">
          <i class="fa-solid fa-exclamation-triangle text-2xl mb-2"></i>
          <div>ไม่ได้รับอาหาร</div>
        </div>
      `;
    }
  }

  // ฟังก์ชันเปิดใช้งาน shop หลังเริ่มเกมเท่านั้น
  function enableIngredientShop() {
    document.querySelectorAll('.ingredient-btn').forEach(btn => {
      btn.onclick = () => {
        const ing = btn.getAttribute('data-ingredient');
        socket.emit('buy_ingredient', { roomId, userId: user.id, ingredient: ing });
      };
    });
    document.getElementById('random-food-btn').onclick = () => {
      socket.emit('random_food', { roomId, userId: user.id });
    };
    updateMyShopUI();
  }

  // --- Ingredient Modal Logic ---
  function showIngredientModal() {
    document.getElementById('ingredient-modal').classList.remove('hidden');
  }
  document.getElementById('close-ingredient-modal').onclick = function() {
    document.getElementById('ingredient-modal').classList.add('hidden');
  };

  // เรียกใช้ enableIngredientShop เมื่อเกมเริ่มเท่านั้น
  // --- Game Start: Show ingredient modal, then randomize food, then show food modal ---
  let gameStartHandled = false;
  socket.on('game_started', () => {
    if (gameStartHandled) return;
    gameStartHandled = true;
    enableIngredientShop();
    // 1. Show ingredient modal
    showIngredientModal();
    // 2. After closing ingredient modal, randomize food and show food modal
    document.getElementById('close-ingredient-modal').onclick = function() {
      document.getElementById('ingredient-modal').classList.add('hidden');
      // Trigger food randomization for this user
      socket.emit('random_food', { roomId, userId: user.id });
    };
  });

  // Join room
  console.log('Joining room:', { roomId, user });
  socket.emit('join_room', roomId, user);

  // อัปเดตรายชื่อผู้เล่นเมื่อเข้าห้องครั้งแรก
  socket.on('player_list_updated', data => {
    console.log('Received player_list_updated:', data);
    if (data && data.roomId == roomId && data.players) {
      console.log('Updating player list:', data.players);
      updatePlayerList(data.players);
    } else {
      console.log('Invalid player_list_updated data:', data);
    }
  });

  // ฟังก์ชันอัปเดตรายชื่อผู้เล่น
  function updatePlayerList(players) {
    console.log('updatePlayerList called with:', players);
    if (!Array.isArray(players)) {
      console.error('Players is not an array:', players);
      return;
    }
    
    const list = document.getElementById('player-list');
    const scoreList = document.getElementById('score-list');
    
    if (!list || !scoreList) {
      console.error('Required DOM elements not found');
      return;
    }
    
    list.innerHTML = '';
    scoreList.innerHTML = '';
    
    players.forEach(player => {
      if (player && player.id && player.name !== undefined) {
        list.innerHTML += `<li class="mb-1 ${player.is_owner ? 'font-bold text-purple-700' : ''}" id="player-li-${player.id}"><i class="fa-solid fa-user"></i> <span class="player-name">${player.name}</span> <span class="text-xs text-gray-400">${player.is_owner ? '(เจ้าของห้อง)' : ''}</span> <span class="ml-2 text-green-600 font-bold">+${player.score || 0}</span></li>`;
        scoreList.innerHTML += `<li class="mb-1 ${player.is_owner ? 'font-bold text-purple-700' : ''}"><i class="fa-solid fa-user"></i> ${player.name} <span class="ml-2 text-green-600 font-bold">+<span id="score-${player.id}">${player.score || 0}</span></span></li>`;
      } else {
        console.warn('Invalid player data:', player);
      }
    });
    
    const playerCountElement = document.getElementById('player-count');
    if (playerCountElement) {
      playerCountElement.textContent = players.length;
    }
  }

  // Update player list real-time เมื่อมีคนเข้าร่วม
  socket.on('user_joined', data => {
    console.log('User joined event received:', data);
  });

  // Update player list real-time เมื่อมีคนออก
  socket.on('user_left', data => {
    console.log('User left event received:', data);
  });

  // ฟัง event update_room_player_count เพื่ออัปเดตจำนวนผู้เล่นแบบ real-time
  socket.on('update_room_player_count', data => {
    if (data && data.roomId == roomId) {
      document.getElementById('player-count').textContent = data.count;
    }
  });



  // จัดการเมื่อผู้ใช้ออกจากหน้าเว็บ
  window.addEventListener('beforeunload', () => {
    socket.emit('leave_room', roomId, user);
  });

  // จัดการเมื่อผู้ใช้กดปุ่มย้อนกลับ
  window.addEventListener('popstate', () => {
    socket.emit('leave_room', roomId, user);
  });


  // Owner starts game
  if (isOwner) {
    document.getElementById('start-btn').onclick = () => {
      // Show question select modal
      socket.emit('request_questions', roomId);
      document.getElementById('start-btn').classList.add('hidden');
    };
    document.getElementById('next-btn').onclick = () => {
      socket.emit('next_question', roomId);
    };
  }

  // Owner receives questions to select
  socket.on('select_questions', function(questions) {
    let html = `<div id="question-select-modal" class="fixed inset-0 bg-black/40 flex items-center justify-center z-50">
      <div class="bg-white rounded-xl p-8 max-w-2xl w-full">
        <h3 class="text-xl font-bold mb-4">เลือกคำถามสำหรับเกมนี้ (เลือก 14 ข้อ)</h3>
        <div id="question-select-alert" class="mb-2 text-red-600 font-semibold hidden">เลือกครบ 14 ข้อแล้ว</div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 max-h-96 overflow-y-auto mb-4">
          ${questions.map((q, i) => `
            <label class="flex items-start gap-2">
              <input type="checkbox" class="q-checkbox" value="${q.id}">
              <span>${i+1}. ${q.question_text}</span>
            </label>
          `).join('')}
        </div>
        <button id="confirm-questions-btn" class="bg-purple-600 hover:bg-purple-700 text-white font-bold px-6 py-2 rounded-xl">ยืนยัน</button>
      </div>
    </div>`;
    document.body.insertAdjacentHTML('beforeend', html);
    // Alert when 14 selected
    const checkboxes = document.querySelectorAll('.q-checkbox');
    const alert14 = document.getElementById('question-select-alert');
    checkboxes.forEach(cb => {
      cb.addEventListener('change', () => {
        const checkedCount = document.querySelectorAll('.q-checkbox:checked').length;
        if (checkedCount === 14) {
          alert14.classList.remove('hidden');
        } else {
          alert14.classList.add('hidden');
        }
      });
    });
    document.getElementById('confirm-questions-btn').onclick = () => {
      const checked = Array.from(document.querySelectorAll('.q-checkbox:checked')).map(cb => parseInt(cb.value));
      if (checked.length !== 14) {
        alert('กรุณาเลือก 14 ข้อ');
        return;
      }
      // Send selected question ids to backend
      socket.emit('questions_selected', roomId, checked);
      document.getElementById('question-select-modal').remove();
      // Show 20s countdown before game starts
      let countdown = 20;
      let countdownModal = document.createElement('div');
      countdownModal.id = 'countdown-modal';
      countdownModal.className = 'fixed inset-0 bg-black/40 flex items-center justify-center z-50';
      countdownModal.innerHTML = `<div class="bg-white rounded-2xl p-8 max-w-xs w-full text-center">
        <h3 class="text-xl font-bold mb-4 text-purple-700">เกมจะเริ่มใน <span id='countdown-timer'>${countdown}</span> วินาที</h3>
      </div>`;
      document.body.appendChild(countdownModal);
      let timer = setInterval(() => {
        countdown--;
        document.getElementById('countdown-timer').textContent = countdown;
        if (countdown <= 0) {
          clearInterval(timer);
          document.getElementById('countdown-modal').remove();
          // Notify backend to start game for all
          socket.emit('start_game', roomId, user.id);
        }
      }, 1000);
    };
  });
  // รับ event select_questions (เฉพาะเจ้าของห้อง)
  socket.on('select_questions', function(questions) {
    // แสดง UI ให้เจ้าของห้องเลือกคำถาม (เลือก 14 ข้อ)
    let html = `<div id="question-select-modal" class="fixed inset-0 bg-black/40 flex items-center justify-center z-50">
      <div class="bg-white rounded-xl p-8 max-w-2xl w-full">
        <h3 class="text-xl font-bold mb-4">เลือกคำถามสำหรับเกมนี้ (เลือก 14 ข้อ)</h3>
        <div id="question-select-alert" class="mb-2 text-red-600 font-semibold hidden">เลือกครบ 14 ข้อแล้ว</div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 max-h-96 overflow-y-auto mb-4">
          ${questions.map((q, i) => `
            <label class="flex items-start gap-2">
              <input type="checkbox" class="q-checkbox" value="${q.id}">
              <span>${i+1}. ${q.question_text}</span>
            </label>
          `).join('')}
        </div>
        <button id="confirm-questions-btn" class="bg-purple-600 hover:bg-purple-700 text-white font-bold px-6 py-2 rounded-xl">ยืนยัน</button>
      </div>
    </div>`;
    document.body.insertAdjacentHTML('beforeend', html);
    // เพิ่ม event สำหรับแจ้งเตือนเมื่อเลือกครบ 14 ข้อ
    const checkboxes = document.querySelectorAll('.q-checkbox');
    const alert14 = document.getElementById('question-select-alert');
    checkboxes.forEach(cb => {
      cb.addEventListener('change', () => {
        const checkedCount = document.querySelectorAll('.q-checkbox:checked').length;
        if (checkedCount === 14) {
          alert14.classList.remove('hidden');
        } else {
          alert14.classList.add('hidden');
        }
      });
    });
    document.getElementById('confirm-questions-btn').onclick = () => {
      const checked = Array.from(document.querySelectorAll('.q-checkbox:checked')).map(cb => parseInt(cb.value));
      if (checked.length !== 14) {
        alert('กรุณาเลือก 14 ข้อ');
        return;
      }
      // ส่ง id ของคำถามที่เลือกไป backend
      const selected = questions.filter(q => checked.includes(q.id));
      socket.emit('questions_selected', roomId, selected);
      document.getElementById('question-select-modal').remove();
      document.getElementById('next-btn').classList.remove('hidden');
    };
    // --- กำลังสุ่มอาหารให้ผู้เล่นทุกคน ---
    // แสดงข้อความกำลังสุ่มอาหาร 2 วินาที
    const assignedFoodsContainer = document.getElementById('my-assigned-foods');
    if (assignedFoodsContainer) {
      assignedFoodsContainer.innerHTML = `<div class="col-span-full text-center text-gray-500 py-4">
        <i class="fa-solid fa-clock text-2xl mb-2"></i>
        <div>กำลังสุ่มอาหาร...</div>
      </div>`;
    }
    setTimeout(() => {
      socket.emit('random_food', { roomId, userId: user.id });
    }, 2000);
  });

  // รับชุดคำถามที่ใช้เล่นจริง (ทุกคนในห้อง)
  socket.on('game_questions', function(selectedQuestions) {
    // ใช้ลำดับคำถามที่ backend ส่งมา (ไม่ต้อง shuffle อีก)
    questions = selectedQuestions;
    currentQuestion = 0;
    document.getElementById('waiting-area')?.classList.add('hidden');
    if (!isOwner) {
      document.getElementById('start-btn')?.classList.add('hidden');
    }
    // เริ่มเกมด้วยฟังก์ชั่น runGame
    runGame();
  // ฟังก์ชั่นหลักสำหรับรันเกมทีละข้อ
  function runGame() {
    if (currentQuestion >= questions.length) {
      showSummary();
      return;
    }
    showCountdown(20, () => {
      showQuestionWithTimer(15, () => {
        showAnswer();
        setTimeout(() => {
          currentQuestion++;
          runGame();
        }, 3000); // แสดงเฉลย 3 วินาที
      });
    });
  }

  // แสดงคำถามพร้อมจับเวลา (15 วินาที)
  function showQuestionWithTimer(seconds, onFinish) {
    const q = questions[currentQuestion];
    if (!q) return;
    const gameArea = document.getElementById('game-area');
    let timeLeft = seconds;
    gameArea.innerHTML = `
      <div class="mb-4">
        <div class="text-xl font-bold mb-2">ข้อที่ ${currentQuestion+1}: ${q.question_text}</div>
        <div class="text-gray-500 mb-2">คำใบ้: ${q.hint || '-'} </div>
        <div class="text-lg text-purple-700 font-bold mb-2">เวลาที่เหลือ: <span id='question-timer'>${timeLeft}</span> วินาที</div>
    // จัดการปุ่มลบห้อง (เฉพาะเจ้าของห้อง)
    const deleteRoomBtn = document.getElementById('delete-room-btn');
    if (deleteRoomBtn) {
      deleteRoomBtn.onclick = function() {
        if (confirm('คุณต้องการลบห้องนี้ใช่หรือไม่?')) {
          socket.emit('delete_room', roomId, user.id);
        }
      };
    }
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        ${[q.choice1, q.choice2, q.choice3, q.choice4].map((c, i) => `<button class='choice-btn bg-purple-100 hover:bg-purple-300 text-purple-800 font-bold py-3 rounded-xl' data-idx='${i}'>${c}</button>`).join('')}
      </div>
      <div class="mt-4 text-gray-400 text-sm">* ตอบไวได้คะแนนเยอะ ตอบช้าคะแนนลดลง</div>
    `;
    answered = false;
    startTime = Date.now();
    document.querySelectorAll('.choice-btn').forEach(btn => {
      btn.onclick = () => {
        if (answered) return;
        answered = true;
        const answerIdx = btn.getAttribute('data-idx');
        const answerTime = Date.now() - startTime;
        socket.emit('submit_answer', { roomId, userId: user.id, answerIndex: answerIdx, answerTime });
        btn.classList.add('bg-green-300');
      };
    });
    // จับเวลา
    const timer = setInterval(() => {
      timeLeft--;
      const timerEl = document.getElementById('question-timer');
      if (timerEl) timerEl.textContent = timeLeft;
      if (timeLeft <= 0) {
        clearInterval(timer);
        if (typeof onFinish === 'function') onFinish();
      }
    }, 1000);
  }

  // แสดงเฉลยคำตอบ
  function showAnswer() {
    const q = questions[currentQuestion];
    const gameArea = document.getElementById('game-area');
    let answerText = [q.choice1, q.choice2, q.choice3, q.choice4][q.answer_index-1];
    gameArea.innerHTML += `<div class="mt-4 text-green-700 font-bold text-lg">เฉลย: ${answerText}</div>`;
  }

  // สรุปคะแนนและจัดอันดับ
  function showSummary() {
    // สมมติว่ามี scoreList ใน DOM และคะแนนอัปเดตแล้ว
    // ดึงคะแนนจาก DOM
    let playerEls = document.querySelectorAll('#score-list li');
    let players = [];
    playerEls.forEach(li => {
      const name = li.textContent.match(/👤\s*(.*?)\s*\+/)[1];
      const score = parseInt(li.querySelector('span[id^="score-"]').textContent) || 0;
      players.push({ name, score, el: li });
    });
    // จัดอันดับ
    players.sort((a, b) => b.score - a.score);
    // ให้คะแนนอันดับ 1 ได้ 4 คะแนน, 2 ได้ 3, 3 ได้ 2, 4 ได้ 1, 5 ได้ 0
    players.forEach((p, idx) => {
      let rankScore = Math.max(4-idx, 0);
      p.rankScore = rankScore;
    });
    // แสดงผล
    let html = `<div class="text-2xl font-bold mb-4 text-center text-purple-700">สรุปผลคะแนน</div><ol class="list-decimal pl-8">`;
    players.forEach((p, idx) => {
      html += `<li class="mb-2 text-lg">${idx+1}. ${p.name} <span class="text-green-700 font-bold">${p.score} คะแนน</span> <span class="text-blue-700 font-bold">(+${p.rankScore} อันดับ)</span></li>`;
    });
    html += '</ol>';
    document.getElementById('game-area').innerHTML = html;
  }
  // ฟังก์ชั่นนับถอยหลัง
  function showCountdown(seconds, onFinish) {
    const gameArea = document.getElementById('game-area');
    let timeLeft = seconds;
    gameArea.innerHTML = `<div class="text-3xl font-bold text-purple-700 mb-4">เกมจะเริ่มใน <span id='countdown-timer'>${timeLeft}</span> วินาที</div>`;
    const timer = setInterval(() => {
      timeLeft--;
      document.getElementById('countdown-timer').textContent = timeLeft;
      if (timeLeft <= 0) {
        clearInterval(timer);
        if (typeof onFinish === 'function') onFinish();
      }
    }, 1000);
  }

  // ฟังก์ชั่นสุ่ม array (Fisher-Yates)
  function shuffleArray(array) {
    let arr = array.slice();
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }
  });

  // Listen for game start (question UI)
  let selectedAnswerIdx = null;
  socket.on('game_started', () => {
    selectedAnswerIdx = null;
    showQuestion();
    document.getElementById('waiting-area').classList.add('hidden');
    if (!isOwner) {
      document.getElementById('start-btn')?.classList.add('hidden');
    }
  });

  // Listen for next question
  socket.on('next_question', () => {
    currentQuestion++;
    selectedAnswerIdx = null;
    showQuestion();
    answered = false;
  });

  // Show question
  function showQuestion() {
    const q = questions[currentQuestion];
    if (!q) return;
    const gameArea = document.getElementById('game-area');
    // สร้างปุ่มตัวเลือกโดย mark active ถ้าเลือกแล้ว
    let choicesHtml = [q.choice1, q.choice2, q.choice3, q.choice4].map((c, i) => {
      let btnClass = 'choice-btn bg-purple-100 hover:bg-purple-300 text-purple-800 font-bold py-3 rounded-xl';
      if (selectedAnswerIdx !== null && selectedAnswerIdx == i) btnClass += ' ring-4 ring-green-400';
      return `<button class='${btnClass}' data-idx='${i}' ${selectedAnswerIdx !== null ? 'disabled' : ''}>${c}</button>`;
    }).join('');
    gameArea.innerHTML = `
      <div class="mb-4">
        <div class="text-xl font-bold mb-2">ข้อที่ ${currentQuestion+1}: ${q.question_text}</div>
        <div class="text-gray-500 mb-2">คำใบ้: ${q.hint || '-'} </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        ${choicesHtml}
      </div>
      <div class="mt-4 text-gray-400 text-sm">* ตอบไวได้คะแนนเยอะ ตอบช้าคะแนนลดลง</div>
    `;
    startTime = Date.now();
    document.querySelectorAll('.choice-btn').forEach(btn => {
      btn.onclick = () => {
        if (answered || selectedAnswerIdx !== null) return;
        answered = true;
        selectedAnswerIdx = parseInt(btn.getAttribute('data-idx'));
        const answerTime = Date.now() - startTime;
        socket.emit('submit_answer', { roomId, userId: user.id, answerIndex: selectedAnswerIdx, answerTime });
        // แสดงปุ่มที่เลือกค้างไว้
        document.querySelectorAll('.choice-btn').forEach((b, idx) => {
          if (idx === selectedAnswerIdx) {
            b.classList.add('ring-4', 'ring-green-400');
          }
          b.disabled = true;
        });
      };
    });
  }

  // Listen for user answered (update score)
  // --- ให้ทุก client แสดงปุ่มที่เลือกของตัวเองตรงกัน ---
  socket.on('user_answered', data => {
    // อัปเดตคะแนน
    if (data.userId && data.score !== undefined) {
      document.getElementById('score-' + data.userId).textContent = data.score;
    }
    // ถ้าเป็น user นี้ ให้แสดงปุ่มที่เลือกไว้ (active) ค้างไว้
    if (data.userId === user.id && typeof data.answerIndex !== 'undefined') {
      selectedAnswerIdx = parseInt(data.answerIndex);
      // อัปเดตปุ่มให้ active
      document.querySelectorAll('.choice-btn').forEach((b, idx) => {
        if (idx === selectedAnswerIdx) {
          b.classList.add('ring-4', 'ring-green-400');
        }
        b.disabled = true;
      });
    }
  });
</script>
<script>
  // Pass data from EJS to JavaScript
  // @ts-ignore
  window.user = <%- JSON.stringify({ id: user.id, name: user.name }) %>;
  // @ts-ignore
  window.isOwner = <%= user.id === room.creator_id ? 'true' : 'false' %>;
  // @ts-ignore
  window.questions = <%- JSON.stringify(questions) %>;
  // @ts-ignore
  window.roomId = "<%= room.id %>";
  // @ts-ignore
  window.playerFoods = <%- JSON.stringify(playerFoods || {}) %>;
  <% if (typeof playerIngredients !== 'undefined') { %>
  // @ts-ignore
  window.playerIngredients = <%- JSON.stringify(playerIngredients) %>;
  <% } else { %>
  // @ts-ignore
  window.playerIngredients = {};
  <% } %>
  <% 
    const currentPlayer = players.find(p => p.id === user.id);
    const currentPlayerScore = currentPlayer ? currentPlayer.score : 0;
    let currentPlayerIngredients = [];
    if (typeof playerIngredients !== 'undefined' && playerIngredients[user.id]) {
      currentPlayerIngredients = playerIngredients[user.id];
    }
  %>
  // @ts-ignore
  window.initialPlayerScore = <%= currentPlayerScore %>;
  // @ts-ignore
  window.initialPlayerIngredients = <%- JSON.stringify(currentPlayerIngredients) %>;
  // @ts-ignore
  window.ingredients = <%- JSON.stringify(ingredients || []) %>;
  // @ts-ignore
  window.mealIngredients = <%- JSON.stringify(mealIngredients || []) %>;
  <% if (typeof gameState !== 'undefined' && gameState) { %>
  // @ts-ignore
  window.initialGameState = <%- JSON.stringify(gameState) %>;
  <% } else { %>
  // @ts-ignore
  window.initialGameState = null;
  <% } %>
  // @ts-ignore
  window.isGameFinished = <%= typeof isGameFinished !== 'undefined' && isGameFinished ? 'true' : 'false' %>;
</script>
  <div class="container mx-auto px-4 py-8">
    <h2 class="text-2xl font-bold mb-4 text-center">ห้อง: <%= room.name %></h2>
    
    
    <% if (typeof isGameFinished !== 'undefined' && isGameFinished) { %>
    <!-- แสดงผู้ชนะเมื่อเกมจบแล้ว -->
    <div id="game-over-banner" class="bg-gradient-to-br from-green-400 via-green-500 to-green-600 rounded-3xl p-8 mb-6 text-center shadow-2xl border-4 border-green-300 relative overflow-hidden" style="display: block;">
      <!-- Background pattern -->
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-4 left-4 text-4xl">🍽️</div>
        <div class="absolute top-8 right-8 text-3xl">🏆</div>
        <div class="absolute bottom-6 left-8 text-3xl">🎉</div>
        <div class="absolute bottom-4 right-4 text-4xl">👑</div>
      </div>
      
      <div class="relative z-10">
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-20 h-20 bg-white rounded-full shadow-lg mb-4">
            <i class="fa-solid fa-crown text-4xl text-green-600"></i>
          </div>
        </div>
        
        <h3 class="text-4xl font-black text-white mb-3 tracking-wide drop-shadow-lg">
          <span class="text-yellow-300">
            🎊 เกมจบแล้ว! 🎊
          </span>
        </h3>
        
        <p class="text-xl text-white mb-6 font-semibold">
          มีผู้เล่นทำอาหารครบทุกอย่างแล้ว
        </p>

          <div class="bg-white rounded-2xl p-6 border-2 border-yellow-300 inline-block shadow-xl">
            <div class="flex items-center justify-center gap-3 mb-4">
              <i class="fa-solid fa-trophy text-2xl text-yellow-600"></i>
              <p class="text-gray-800 font-bold text-lg">
                ผู้ชนะ: <span id="winner-name" class="text-yellow-600 font-extrabold text-xl">รอข้อมูล...</span>
              </p>
            </div>
            
            <!-- ส่วนแสดงเมนูที่ผู้ชนะได้รับ -->
            <div id="winner-foods-display" class="mt-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg" style="display: none;">
              <h4 class="text-sm font-bold text-yellow-800 mb-2 text-center">
                <i class="fa-solid fa-utensils mr-1"></i>เมนูที่ได้รับ:
              </h4>
              <div id="winner-foods-list" class="flex flex-wrap gap-2 justify-center">
                <!-- เมนูจะถูกเพิ่มด้วย JavaScript -->
              </div>
            </div>
          </div>
          
        
        <div class="mt-6 text-white text-sm font-medium">
          <i class="fa-solid fa-info-circle mr-2"></i>
          ห้องนี้จบเกมแล้ว - ไม่สามารถเล่นต่อได้
        </div>

      <div class="mt-8">
        <button id="leave-room-btn-finished" class="cursor-pointer bg-red-500 hover:bg-red-600 text-white font-bold px-6 py-3 rounded-xl shadow-lg transition">
          <i class="fa-solid fa-arrow-right-from-bracket mr-2"></i>ออกจากห้อง
        </button>
      </div>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const leaveBtn = document.getElementById('leave-room-btn-finished');
          if (leaveBtn) {
            leaveBtn.addEventListener('click', function() {
              window.location.href = '/quiz';
            });
          }
        });
      </script>
      </div>
    </div>
    <% } %>

    <!-- ส่วนแสดงผู้ชนะที่ซ่อนอยู่ (จะแสดงเมื่อได้รับ event game_ended) -->
    <div id="game-over-banner-hidden" class="bg-gradient-to-br from-green-400 via-green-500 to-green-600 rounded-3xl p-8 mb-6 text-center shadow-2xl border-4 border-green-300 relative overflow-hidden" style="display: none;">
      <!-- Background pattern -->
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-4 left-4 text-4xl">🍽️</div>
        <div class="absolute top-8 right-8 text-3xl">🏆</div>
        <div class="absolute bottom-6 left-8 text-3xl">🎉</div>
        <div class="absolute bottom-4 right-4 text-4xl">👑</div>
      </div>
      
      <div class="relative z-10">
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-20 h-20 bg-white rounded-full shadow-lg mb-4">
            <i class="fa-solid fa-crown text-4xl text-green-600"></i>
          </div>
        </div>
        
        <h3 class="text-4xl font-black text-white mb-3 tracking-wide drop-shadow-lg">
          <span class="text-yellow-300">
            🎊 เกมจบแล้ว! 🎊
          </span>
        </h3>
        
        <p class="text-xl text-white mb-6 font-semibold">
          มีผู้เล่นทำอาหารครบทุกอย่างแล้ว
        </p>

        <div class="bg-white rounded-2xl p-6 border-2 border-yellow-300 inline-block shadow-xl">
          <div class="flex items-center justify-center gap-3 mb-4">
            <i class="fa-solid fa-trophy text-2xl text-yellow-600"></i>
            <p class="text-gray-800 font-bold text-lg">
              ผู้ชนะ: <span id="winner-name-hidden" class="text-yellow-600 font-extrabold text-xl">รอข้อมูล...</span>
            </p>
          </div>
          
          <!-- ส่วนแสดงเมนูที่ผู้ชนะได้รับ -->
          <div id="winner-foods-display-hidden" class="mt-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg" style="display: none;">
            <h4 class="text-sm font-bold text-yellow-800 mb-2 text-center">
              <i class="fa-solid fa-utensils mr-1"></i>เมนูที่ได้รับ:
            </h4>
            <div id="winner-foods-list-hidden" class="flex flex-wrap gap-2 justify-center">
              <!-- เมนูจะถูกเพิ่มด้วย JavaScript -->
            </div>
          </div>
        </div>
        
        <div class="mt-6 text-white text-sm font-medium">
          <i class="fa-solid fa-info-circle mr-2"></i>
          ห้องนี้จบเกมแล้ว - ไม่สามารถเล่นต่อได้
        </div>

        <div class="mt-8">
          <button id="leave-room-btn-finished-hidden" class="cursor-pointer bg-red-500 hover:bg-red-600 text-white font-bold px-6 py-3 rounded-xl shadow-lg transition">
            <i class="fa-solid fa-arrow-right-from-bracket mr-2"></i>ออกจากห้อง
          </button>
        </div>
      </div>
    </div>

  <div class="flex flex-col md:flex-row gap-6 mb-6">
    <div class="flex-1 bg-white rounded-2xl shadow p-6">
      <h3 class="text-lg font-semibold mb-2">
        ผู้เล่นในห้อง (<span id="player-count"><%= players.length %></span>/<%= room.max_players %>)
      </h3>
      <ul id="player-list">
        <% players.forEach(function(player) { %>
          <li class="mb-1 <%= player.is_owner ? 'font-bold text-purple-700' : '' %>" id="player-li-<%= player.id %>">
            <i class="fa-solid fa-user"></i> <span class="player-name"><%= player.name %></span> 
            <span class="text-xs text-gray-400"><%= player.is_owner ? '(เจ้าของห้อง)' : '' %></span> 
            <span class="ml-2 text-green-600 font-bold">+<%= player.score %></span>
            <span class="ml-2 inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
              <i class="fa-solid fa-circle text-green-500 mr-1"></i>ออนไลน์
            </span>

            <% if (playerFoods[player.id] && playerFoods[player.id].length > 0) { %>
              <div class="mt-1 text-xs text-blue-600">
                <i class="fa-solid fa-utensils mr-1"></i>
                <%= playerFoods[player.id].join(', ') %>
              </div>
            <% } %>
          </li>
        <% }); %>
      </ul>
    </div>
    
    <div class="flex-1 bg-white rounded-2xl shadow p-6">
      <div id="game-area" <% if (typeof isGameFinished !== 'undefined' && isGameFinished) { %>style="display: none;"<% } %>>
        <!-- ส่วนแสดงคำถามและตัวเลือกจะถูกเติมโดย JS -->
        <div id="waiting-area" class="text-center text-lg text-gray-500">
          <span id="waiting-message">รอเจ้าของห้องเริ่มเกม...</span>
        </div>
        <div>
          <button id="leave-room-btn" class="mt-4 bg-gradient-to-r bg-red-500 hover:bg-red-600 text-white font-bold px-4 py-2 rounded-lg shadow-md mx-auto block">ออกจากห้อง</button>        </div>
        </div>
      <% if (user.id === room.creator_id) { %>
        <button id="start-btn" class="mt-4 bg-gradient-to-r from-[#ff6a6a] to-[#ff8c42] text-white font-bold px-8 py-3 rounded-2xl text-lg w-full" <% if (typeof isGameFinished !== 'undefined' && isGameFinished) { %>style="display: none;"<% } %>>เริ่มเกม</button>
        <button id="next-btn" class="mt-4 bg-gradient-to-r from-[#ff8c42] to-[#ff6a6a] text-white font-bold px-8 py-3 rounded-2xl text-lg w-full hidden">ข้อถัดไป</button>
        <button id="reset-game-btn" class="mt-4 bg-gradient-to-r from-[#3b82f6] to-[#1d4ed8] text-white font-bold px-8 py-3 rounded-2xl text-lg w-full hidden">
          <i class="fa-solid fa-rotate mr-2"></i>รีเซ็ตเกม
        </button>

        <button id="delete-room-btn" class="mt-4 bg-red-500 hover:bg-red-700 text-white font-bold px-8 py-3 rounded-2xl text-lg w-full">ลบห้อง</button>
      <% } %>
    </div>
  </div>

  <div class="bg-white rounded-2xl shadow p-6 mt-6">
    <div class="mb-4">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-green-100 text-green-600 shadow">
          <i class="fa-solid fa-bowl-food text-xl"></i>
        </span>
        <h4 class="text-xl font-extrabold text-green-800 tracking-tight drop-shadow">อาหารที่ได้รับ</h4>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% 
          // แสดงเฉพาะอาหารที่ผู้เล่นได้รับ
          const currentPlayerFoods = playerFoods[user.id] || [];
          if (currentPlayerFoods.length > 0) {
            // กรองเฉพาะอาหารที่มีใน playerFoods
            const availableMeals = mealIngredients.filter(meal => 
              currentPlayerFoods.includes(meal.meal_name)
            );
        %>
          <% availableMeals.forEach(function(meal) { %>
            <div class="bg-green-50 rounded-xl p-4 flex flex-col items-center shadow border border-green-100 hover:bg-green-100 transition-colors duration-200">
              <div class="w-24 h-24 bg-white rounded-xl mb-2 flex items-center justify-center overflow-hidden border border-green-200">
                <% if (meal.image_file) { %>
                  <img src="/img/<%= meal.image_file %>" 
                       alt="<%= meal.meal_name %>" 
                       class="object-cover w-full h-full" 
                       loading="lazy"
                       onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                  
                  <!-- Fallback icon if image fails -->
                  <div style="display:none;" class="flex items-center justify-center">
                    <i class="fa-solid fa-utensils text-green-400 text-2xl"></i>
                  </div>
                <% } else { %>
                  <!-- No image file found - show default icon -->
                  <span class="text-4xl text-green-300">
                    <i class="fa-solid fa-utensils"></i>
                  </span>
                <% } %>
              </div>
              
              <div class="font-bold text-xl text-green-800 text-center mb-1"><%= meal.meal_name %></div>
              <div class="text-gray-700 text-center mb-2">วัตถุดิบ: <%= meal.ingredients %></div>
              
              <!-- เพิ่มปุ่มสำหรับทำอาหาร -->
              <button class="cook-meal-btn cursor-pointer mt-4 bg-green-500 hover:bg-green-600 text-white rounded-lg px-6 py-4 font-semibold transition-colors duration-200" 
                      data-meal="<%= meal.meal_name %>" 
                      data-ingredients="<%= meal.ingredients %>">
                <i class="fa-solid fa-fire mr-1"></i>ทำอาหาร
              </button>
              <!-- สถานะการทำอาหาร (จะถูกอัปเดตด้วย JavaScript) -->
              <div class="cook-status mt-2 text-center hidden">
                <span class="inline-flex items-center bg-green-100 text-green-800 text-xs font-semibold px-2 py-1 rounded-full">
                  <i class="fa-solid fa-check mr-1"></i>ทำเสร็จแล้ว
                </span>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="col-span-full text-center p-8 bg-gray-100 border-2 border-dashed border-gray-300 rounded-xl flex flex-col items-center justify-center">
            <i class="fa-solid fa-utensils text-gray-400 text-4xl mb-4"></i>
            <p class="text-gray-600 font-semibold">ยังไม่มีอาหารที่ได้รับ</p>
            <p class="text-gray-500 text-sm mt-2">เล่นเกมเพื่อรับอาหารใหม่</p>
          </div>
        <% } %>
      </div>
    </div>

    <div class="mt-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-green-100 text-green-600 shadow">
          <i class="fa-solid fa-leaf text-xl"></i>
        </span>
        <h4 class="text-xl font-extrabold text-green-800 tracking-tight drop-shadow">วัตถุดิบของคุณ</h4>
      </div>
      <div id="my-ingredients" class="flex flex-wrap gap-2 p-4 bg-green-50 rounded-xl border border-green-200 min-h-[60px]">
        <span class="text-gray-500 italic">ยังไม่มี</span>
      </div>
    </div>

    <div id="ingredient-shop" class="mt-8">
      <div class="flex flex-col sm:flex-row items-center justify-between mb-4">
        <h3 class="text-2xl sm:mb-0 mb-4 font-extrabold text-yellow-700 flex items-center gap-2">
          <i class="fa-solid fa-store text-yellow-500"></i>
          ร้านขายวัตถุดิบ
        </h3>
        <div class="flex items-center gap-2 bg-yellow-100 border border-yellow-300 rounded-lg px-4 py-2 shadow-sm">
          <span class="text-yellow-700 font-semibold text-lg"><i class="fa-solid fa-coins"></i> แต้มของคุณ:</span>
          <span id="my-points" class="text-yellow-900 font-bold text-xl drop-shadow-sm">0</span>
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-2">
        <% if (typeof ingredients !== 'undefined' && Array.isArray(ingredients) && ingredients.length > 0) { %>
          <% ingredients.forEach(function(ing) { %>
      <div class="flex flex-col items-center bg-yellow-50 rounded-xl p-2 shadow border border-yellow-100">
        <div class="w-20 h-20 bg-white rounded-xl mb-1 flex items-center justify-center overflow-hidden border border-yellow-200">
          <% if (ing.image_file) { %>
            <img src="/img/<%= ing.image_file %>" 
                 alt="<%= ing.name %>" 
                 class="object-cover w-full h-full" 
                 loading="lazy"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
            
            <!-- Fallback icon if image fails -->
            <div style="display:none;" class="flex items-center justify-center">
              <i class="fa-solid fa-utensils text-yellow-400 text-lg"></i>
            </div>
          <% } else { %>
            <!-- No image mapping found -->
            <span class="text-2xl text-yellow-300">
              <i class="fa-solid fa-carrot"></i>
            </span>
          <% } %>
        </div>
        <div class="flex flex-col items-center w-full">
          <span class="text-base font-semibold text-yellow-800 mb-1"><%= ing.name %></span>
          <button class="ingredient-btn cursor-pointer flex items-center justify-center gap-2 bg-yellow-100 hover:bg-yellow-200 text-yellow-900 font-bold px-3 py-4 rounded-xl mt-1 w-full shadow transition-all duration-200 border border-yellow-200"
              data-ingredient="<%= ing.name %>"
              data-price="<%= ing.price %>">
            <span class="pointer-events-none flex items-center gap-2">
              <i class="fa-solid fa-basket-shopping text-yellow-500"></i>
              <span>ซื้อ <span class="font-bold"><%= ing.price %></span> แต้ม</span>
            </span>
          </button>
        </div>
      </div>
    <% }); %>
    
  <% } else { %>
    <div class="col-span-full text-center p-8 bg-gray-100 border-2 border-dashed border-gray-300 rounded-xl flex flex-col items-center justify-center">
      <i class="fa-solid fa-shopping-basket text-gray-400 text-4xl mb-4"></i>
      <p class="text-gray-600 font-semibold">ไม่มีรายการวัตถุดิบ</p>
      <p class="text-gray-500 text-sm mt-2">กรุณาเพิ่มวัตถุดิบในระบบ</p>
      <% /* Show unique ingredient tags from mealIngredients even if shop is empty */ %>
      <% if (typeof mealIngredientRows !== 'undefined' && Array.isArray(mealIngredientRows) && mealIngredientRows.length > 0) { %>
        <% 
          // mealIngredientRows: array of { ingredient: 'xxx', ... }
          let uniqueIngredients = [];
          mealIngredientRows.forEach(function(row) {
            let trimmed = row.ingredient && row.ingredient.trim();
            if (trimmed && !uniqueIngredients.includes(trimmed)) {
              uniqueIngredients.push(trimmed);
            }
          });
          // ใช้ชื่อไฟล์จากฐานข้อมูลแทน
          const ingredientImgMap = {};
        %>
        <div class="mt-4">
          <h4 class="text-md font-bold mb-1 text-blue-700">วัตถุดิบที่ใช้ในสูตรอาหารทั้งหมด</h4>
          <div class="flex flex-wrap gap-2 justify-center">
            <% uniqueIngredients.forEach(function(name) { %>
              <span class="inline-flex items-center bg-blue-100 text-blue-800 rounded-full px-2 py-1 text-sm font-semibold gap-2">
                <span class="w-7 h-7 bg-white rounded-full flex items-center justify-center overflow-hidden border border-blue-200 mr-1">
                  <% const imgIndex = ingredientImgMap[name] || ingredientImgMap[name.trim()]; %>
                  <% if (imgIndex) { %>
                    <img src="/img/<%= imgIndex %>.png" alt="<%= name %>" class="object-cover w-full h-full" loading="lazy"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                    <span style="display:none;" class="flex items-center justify-center"><i class="fa-solid fa-utensils text-blue-400 text-base"></i></span>
                  <% } else { %>
                    <span class="text-base text-blue-300"><i class="fa-solid fa-carrot"></i></span>
                  <% } %>
                </span>
                <%= name %>
              </span>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

    <!-- ส่วนแสดงประวัติการทำอาหาร -->
    <div id="cooking-history" class="mt-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-orange-100 text-orange-600 shadow">
          <i class="fa-solid fa-history text-xl"></i>
        </span>
        <h4 class="text-xl font-extrabold text-orange-800 tracking-tight drop-shadow">ประวัติการทำอาหาร</h4>
        <button id="refresh-history-btn" class="ml-auto bg-orange-500 hover:bg-orange-600 text-white px-3 py-1 rounded-lg text-sm font-semibold transition-colors duration-200">
          <i class="fa-solid fa-refresh mr-1"></i>รีเฟรช
        </button>
      </div>
      
      <!-- สถิติการทำอาหาร -->
      <div id="cooking-stats" class="mb-4 bg-orange-100 rounded-lg p-4 border border-orange-200">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 text-center">
          <div class="bg-white rounded-lg p-3 shadow-sm">
            <div class="text-2xl font-bold text-orange-600" id="total-cooked">0</div>
            <div class="text-sm text-orange-800">อาหารที่ทำแล้ว</div>
          </div>
          <div class="bg-white rounded-lg p-3 shadow-sm">
            <div class="text-2xl font-bold text-green-600" id="total-available">0</div>
            <div class="text-sm text-green-800">อาหารที่ได้รับ</div>
          </div>
          <div class="bg-white rounded-lg p-3 shadow-sm">
            <div class="text-2xl font-bold text-blue-600" id="completion-rate">0%</div>
            <div class="text-sm text-blue-800">อัตราการทำ</div>
          </div>
        </div>
      </div>
      
      <div id="cooked-meals-list" class="bg-orange-50 rounded-xl p-4 border border-orange-200 min-h-[100px]">

<div class="container mx-auto px-4 mb-12 mt-6">
  <div class="relative bg-gradient-to-br from-blue-50 via-purple-100 to-pink-50 rounded-3xl p-0 shadow-2xl overflow-hidden">
    <!-- Decorative shapes -->
    <div class="absolute inset-0 pointer-events-none select-none z-0">
      <span class="absolute text-4xl top-4 left-1/4 animate-bounce">🌱</span>
      <span class="absolute text-3xl top-1/2 left-1/6 animate-pulse">🍀</span>
      <span class="absolute text-5xl bottom-8 right-1/4 animate-spin-slow">🥑</span>
      <span class="absolute text-4xl bottom-4 right-8 animate-bounce">🍉</span>
      <span class="absolute top-8 right-8 text-7xl opacity-10 select-none pointer-events-none">✏️</span>
    </div>
    <div class="relative z-10 flex flex-col items-center justify-center gap-6 py-12 px-6 md:px-16">
      <h2 class="text-4xl md:text-5xl font-extrabold mb-2 text-purple-800 drop-shadow-lg flex items-center gap-2">
        แก้ไขข้อมูลห้อง
      </h2>
      <p class="text-lg text-gray-700 mb-4 font-medium">ปรับแต่งการตั้งค่าห้องของคุณ</p>
      
      <!-- Error Message -->
      <% if (error) { %>
        <div class="bg-red-100 text-red-700 px-4 py-2 rounded mb-4 w-full max-w-md text-center shadow">
          <%= error %>
        </div>
      <% } %>

      <!-- Edit Room Form -->
      <form action="/edit-room" method="POST" class="w-full max-w-md flex flex-col gap-5 bg-white/80 rounded-xl p-8 shadow-lg mt-2">
        <!-- Room Name -->
        <label class="font-medium text-gray-700">ชื่อห้อง <span class="text-red-500">*</span>
          <input type="text" id="name" name="name" value="<%= room.name %>" required
            class="mt-1 p-3 px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-purple-400 transition w-full"
            placeholder="ใส่ชื่อห้องของคุณ">
        </label>

        <!-- Max Players -->
        <label class="font-medium text-gray-700">จำนวนผู้เล่นสูงสุด
          <div class="mt-1 flex items-center gap-2">
            <input type="number" name="max_players" id="max_players_input" value="<%= room.max_players %>" 
              class="flex-1 p-3 px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-purple-400 transition" 
              min="2" max="10">
          </div>
          <span class="text-xs text-gray-500">* จำนวนผู้เล่นที่สามารถเข้าร่วมได้ (2-10 คน)</span>
        </label>

        <!-- Room Color -->
        <div class="font-medium text-gray-700">
          <label>สีห้อง</label>
          <div class="mt-2 grid grid-cols-5 gap-2">
            <input type="radio" name="room_color" value="#a0e7e5" id="color2" class="hidden" <%= room.room_color === '#a0e7e5' ? 'checked' : '' %>>
            <label for="color2" class="w-10 h-10 bg-[#a0e7e5] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
              <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
            </label>
            
            <input type="radio" name="room_color" value="#ffadad" id="color1" class="hidden" <%= room.room_color === '#ffadad' ? 'checked' : '' %>>
            <label for="color1" class="w-10 h-10 bg-[#ffadad] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
              <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
            </label>

            <input type="radio" name="room_color" value="#b5ead7" id="color3" class="hidden" <%= room.room_color === '#b5ead7' ? 'checked' : '' %>>
            <label for="color3" class="w-10 h-10 bg-[#b5ead7] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
              <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
            </label>

            <input type="radio" name="room_color" value="#fdfd96" id="color4" class="hidden" <%= room.room_color === '#fdfd96' ? 'checked' : '' %>>
            <label for="color4" class="w-10 h-10 bg-[#fdfd96] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
              <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
            </label>

            <input type="radio" name="room_color" value="#ffd6a5" id="color5" class="hidden" <%= room.room_color === '#ffd6a5' ? 'checked' : '' %>>
            <label for="color5" class="w-10 h-10 bg-[#ffd6a5] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
              <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
            </label>

            <input type="radio" name="room_color" value="#cdb4db" id="color6" class="hidden" <%= room.room_color === '#cdb4db' ? 'checked' : '' %>>
            <label for="color6" class="w-10 h-10 bg-[#cdb4db] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
              <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
            </label>

            <input type="radio" name="room_color" value="#ffb7c5" id="color7" class="hidden" <%= room.room_color === '#ffb7c5' ? 'checked' : '' %>>
            <label for="color7" class="w-10 h-10 bg-[#ffb7c5] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
              <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
            </label>

            <input type="radio" name="room_color" value="#ffdac1" id="color9" class="hidden" <%= room.room_color === '#ffdac1' ? 'checked' : '' %>>
            <label for="color9" class="w-10 h-10 bg-[#ffdac1] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
              <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
            </label>

            <input type="radio" name="room_color" value="#d0f4de" id="color8" class="hidden" <%= room.room_color === '#d0f4de' ? 'checked' : '' %>>
            <label for="color8" class="w-10 h-10 bg-[#d0f4de] rounded-lg cursor-pointer border-2 border-transparent hover:border-gray-400 transition-all duration-200 flex items-center justify-center">
              <i class="fa-solid fa-check text-white opacity-0 check-icon"></i>
            </label>
          </div>
        </div>

        <!-- Privacy Setting -->
        <div class="font-medium text-gray-700">
          <label class="block mb-3">การตั้งค่าความเป็นส่วนตัว</label>
          <div class="space-y-3">
            <label class="flex items-center space-x-3 cursor-pointer">
              <input type="radio" name="is_private" value="0" <%= !room.is_private ? 'checked' : '' %>
                class="w-4 h-4 text-purple-600 border-gray-300 focus:ring-purple-500">
              <div class="flex items-center space-x-2">
                <span class="text-gray-700">ห้องสาธารณะ - ทุกคนสามารถเข้าร่วมได้</span>
              </div>
            </label>
            <label class="flex items-center space-x-3 cursor-pointer">
              <input type="radio" name="is_private" value="1" <%= room.is_private ? 'checked' : '' %>
                class="w-4 h-4 text-purple-600 border-gray-300 focus:ring-purple-500">
              <div class="flex items-center space-x-2">
                <span class="text-gray-700">ห้องส่วนตัว - ต้องใส่รหัสผ่าน</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Password (conditional) -->
        <div id="passwordSection" class="<%= room.is_private ? '' : 'hidden' %>">
          <label class="font-medium text-gray-700">รหัสผ่านห้อง
            <input type="text" id="password" name="password" value="<%= room.password || '' %>"
              class="mt-1 p-3 px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-purple-400 transition w-full"
              placeholder="ใส่รหัสผ่านสำหรับห้องส่วนตัว">
            <span class="text-xs text-gray-500">รหัสผ่านจะถูกใช้เมื่อห้องเป็นแบบส่วนตัว</span>
          </label>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col gap-3 pt-4">
          <button type="submit"
            class="bg-purple-600 hover:bg-purple-700 text-white font-bold px-8 py-3 rounded-2xl text-lg transition-all duration-300 ease-out shadow-lg flex items-center justify-center gap-2">
            <i class="fa-solid fa-save"></i> บันทึกการเปลี่ยนแปลง
          </button>
          <a href="/quiz"
            class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold px-8 py-3 rounded-2xl text-lg transition-all duration-300 ease-out text-center shadow-lg flex items-center justify-center gap-2">
            <i class="fa-solid fa-times"></i> ยกเลิก
          </a>
        </div>
      </form>

      <!-- Delete Room Section -->
      <div class="w-full max-w-md bg-red-50 border border-red-200 rounded-xl p-6 mt-6">
        <div class="text-center mb-4">
          <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
            <i class="fa-solid fa-trash text-xl text-red-600"></i>
          </div>
          <h3 class="text-lg font-bold text-red-800 mb-1">ลบห้อง</h3>
          <p class="text-red-600 text-sm">การดำเนินการนี้ไม่สามารถยกเลิกได้</p>
        </div>

        <div class="bg-white rounded-lg p-4 mb-4">
          <h4 class="font-semibold text-gray-900 mb-2 text-sm">ข้อมูลห้องที่จะถูกลบ:</h4>
          <ul class="space-y-1 text-xs text-gray-600">
            <li class="flex items-center space-x-2">
              <i class="fa-solid fa-info-circle text-blue-500"></i>
              <span>ชื่อห้อง: <strong><%= room.name %></strong></span>
            </li>
            <li class="flex items-center space-x-2">
              <i class="fa-solid fa-users text-green-500"></i>
              <span>ผู้เล่นทั้งหมดในห้อง</span>
            </li>
            <li class="flex items-center space-x-2">
              <i class="fa-solid fa-question-circle text-purple-500"></i>
              <span>คำถามทั้งหมดในห้อง</span>
            </li>
            <li class="flex items-center space-x-2">
              <i class="fa-solid fa-chart-bar text-orange-500"></i>
              <span>สถิติการเล่นทั้งหมด</span>
            </li>
          </ul>
        </div>

        <button onclick="confirmDeleteRoom()"
          class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-xl transition-all duration-300 ease-out shadow-lg flex items-center justify-center gap-2">
          <i class="fa-solid fa-trash"></i> ลบห้องอย่างถาวร
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // จัดการการเลือกสี
  const colorInputs = document.querySelectorAll('input[name="room_color"]');
  const checkIcons = document.querySelectorAll('.check-icon');

  colorInputs.forEach((input, index) => {
    input.addEventListener('change', function () {
      // ซ่อนเช็คทั้งหมด
      checkIcons.forEach(icon => {
        icon.style.opacity = '0';
        icon.parentElement.classList.remove('border-gray-600');
      });

      // แสดงเช็คที่เลือก
      if (this.checked) {
        checkIcons[index].style.opacity = '1';
        checkIcons[index].parentElement.classList.add('border-gray-600');
      }
    });
  });

  // ตั้งค่าเริ่มต้นตามค่าปัจจุบัน
  const currentColor = '<%= room.room_color %>';
  colorInputs.forEach((input, index) => {
    if (input.value === currentColor) {
      input.checked = true;
      checkIcons[index].style.opacity = '1';
      checkIcons[index].parentElement.classList.add('border-gray-600');
    }
  });

  // แสดง/ซ่อนช่องรหัสผ่านตามการตั้งค่าความเป็นส่วนตัว
  const privacyInputs = document.querySelectorAll('input[name="is_private"]');
  const passwordSection = document.getElementById('passwordSection');

  privacyInputs.forEach(input => {
    input.addEventListener('change', function() {
      if (this.value === '1') {
        passwordSection.classList.remove('hidden');
      } else {
        passwordSection.classList.add('hidden');
      }
    });
  });

  // ฟังก์ชันปรับจำนวนผู้เล่นสูงสุด
  function adjustMaxPlayers(change) {
    const input = document.getElementById('max_players_input');
    const currentValue = parseInt(input.value) || 5;
    const newValue = Math.max(2, Math.min(10, currentValue + change));
    input.value = newValue;
  }
  document.querySelectorAll('input[name="is_private"]').forEach(radio => {
    radio.addEventListener('change', function () {
      const passwordSection = document.getElementById('passwordSection');
      if (this.value === '1') {
        passwordSection.classList.remove('hidden');
      } else {
        passwordSection.classList.add('hidden');
      }
    });
  });

  // Confirm room deletion
  function confirmDeleteRoom() {
    if (confirm('คุณแน่ใจหรือไม่ที่จะลบห้องนี้? การดำเนินการนี้ไม่สามารถยกเลิกได้ และจะลบข้อมูลทั้งหมดที่เกี่ยวข้องกับห้องนี้')) {
      deleteRoom();
    }
  }

  // Delete room function
  function deleteRoom() {
    fetch('/delete-room/<%= room.id %>', {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          alert('ลบห้องเรียบร้อยแล้ว');
          window.location.href = '/quiz';
        } else {
          alert('เกิดข้อผิดพลาด: ' + data.error);
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('เกิดข้อผิดพลาดในการลบห้อง');
      });
  }
</script>

<%- include('partials/footer') %>
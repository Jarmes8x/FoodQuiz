<!-- Navbar -->
<header class="fixed top-0 left-0 w-full z-50 bg-amber-50 shadow-md">
  <div class="container mx-auto px-4 py-8 max-h-20 flex items-center justify-between">
    <a href="/" class="text-4xl font-black bg-gradient-to-r from-red-400 to-orange-400 bg-clip-text text-transparent">
      FoodQuiz
    </a>

    <ul class="hidden md:flex gap-6 text-gray-700 font-semibold">
      <li><a href="/" class="hover:text-orange-500 transition-colors text-xl">หน้าแรก</a></li>
      <li><a href="/about" class="hover:text-orange-500 transition-colors text-xl">เกี่ยวกับ</a></li>
      <li><a href="/quiz" class="hover:text-orange-500 transition-colors text-xl">ห้องคำถาม</a></li>
    </ul>

    <div>
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="relative inline-block text-left" id="user-menu-container">
          <button id="user-menu-btn" type="button" class="cursor-pointer font-bold text-gray-700 mr-4 flex items-center gap-2 focus:outline-none">
            <span><%= user.name %></span>
            <i class="fa-solid fa-user"></i>
            <i id="icon-menu-dropdown" class="fa-solid fa-caret-down transition-transform duration-200"></i>
          </button>
          <div id="user-dropdown" class="hidden absolute overflow-hidden right-0 mt-2 w-40 bg-white border border-gray-200 rounded-lg shadow-lg z-50">
            <a href="/quiz" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">ห้องคำถาม</a>
            <a href="/profile" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">โปรไฟล์</a>
            <a href="/about" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">เกี่ยวกับ</a>
            <form action="/logout" method="POST">
              <button type="submit" class="w-full text-left px-4 py-2 text-gray-700 hover:bg-gray-100">ออกจากระบบ</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <a href="/login"
          class="bg-gradient-to-r from-[#ff6a6a] to-[#ff8c42] hover:from-[#ff4d4d] hover:to-[#ff6a00] hover:scale-105 text-white cursor-pointer font-bold px-8 py-3 rounded-2xl inline-block text-lg transition-all duration-300 ease-out">
          เข้าสู่ระบบ
        </a>
      <% } %>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if(menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }
    // User dropdown
    const userMenuBtn = document.getElementById('user-menu-btn');
    const userDropdown = document.getElementById('user-dropdown');
    const iconMenuDropdown = document.getElementById('icon-menu-dropdown');
    if(userMenuBtn && userDropdown && iconMenuDropdown) {
      userMenuBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        const isOpen = userDropdown.classList.toggle('hidden') === false;
        if (isOpen) {
          iconMenuDropdown.style.transform = 'rotate(180deg)';
        } else {
          iconMenuDropdown.style.transform = 'rotate(0deg)';
        }
      });
      document.addEventListener('click', function(e) {
        if (!userDropdown.classList.contains('hidden')) {
          userDropdown.classList.add('hidden');
          iconMenuDropdown.style.transform = 'rotate(0deg)';
        }
      });
      userDropdown.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    }
  });
</script>
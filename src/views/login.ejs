<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-[#8a6ae2] to-[#764ba2] py-12 px-4">
  <div class="w-full max-w-md bg-white bg-opacity-90 rounded-2xl shadow-2xl p-8 flex flex-col items-center">
    <h1 class="text-3xl font-bold text-purple-700 mb-2 text-center">ยินดีต้อนรับ</h1>
    <p class="text-gray-700 mb-6 text-center">กรุณาใส่ชื่อของคุณเพื่อเข้าสู่ระบบ</p>

    <% if (typeof error !=='undefined' ) { %>
      <div class="w-full mb-4 p-3 bg-red-100 text-red-700 rounded-lg text-center text-sm">
        <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST" class="w-full flex flex-col gap-4">
      <div class="flex flex-col gap-1">
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 pointer-events-none">
            <i class="fa-regular fa-user"></i>
          </span>
          <input type="text" id="name" name="name" required placeholder="ใส่ชื่อของคุณ" class="pl-10 px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-purple-400 transition w-full" autocomplete="off">
        </div>
      </div>
      <button type="submit" class="mt-2 py-4 px-4 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg shadow-md transition">เข้าสู่ระบบ</button>
    </form>

  </div>
</div>

<script src="/js/login.js"></script>